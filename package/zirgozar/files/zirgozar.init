#!/bin/sh /etc/rc.common
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of Zirgozar - https://github.com/dreamboxone/zirgozar

START=95
STOP=10
USE_PROCD=1

ZGZ_LIB=/usr/libexec
. "$ZGZ_LIB/zgz-common.sh"

MKCONFIG="$ZGZ_LIB/zgz-mkconfig"
RULES="$ZGZ_LIB/zgz-rules"
DNS="$ZGZ_LIB/zgz-dns"
BRIDGE="$ZGZ_LIB/zgz-bridge"
STATS="$ZGZ_LIB/zgz-stats"
STARTED_FLAG="$ZGZ_RUN/instance-opened"

# PassWall2's Delay Start: after a reboot, wait this many seconds before
# starting. The network - and above all the WAN - is often not there yet when
# the boot sequence reaches this, and a start that finds no way out chooses a
# node against a connection that is still coming up.
boot() {
	_d="$(cfg start_delay 1)"
	case "$_d" in ''|*[!0-9]*) _d=0 ;; esac
	if [ "$_d" -gt 0 ]; then
		( sleep "$_d"; /etc/init.d/zirgozar start ) >/dev/null 2>&1 &
		return 0
	fi
	start "$@"
}

start_service() {
	rm -f "$STARTED_FLAG"

	# The rebind exceptions on the Traffic Rules page belong to dnsmasq, not
	# to the tunnel, so they are brought in step whether or not the tunnel is
	# about to start - this runs on every boot and on every save.
	"$ZGZ_LIB/zgz-router" rebind >/dev/null 2>&1 || true
	# Nodes and subscriptions with names of their own, not places in the
	# file - see zgz-nodes. Before anything reads a setting naming one.
	"$ZGZ_LIB/zgz-nodes" fixnames >/dev/null 2>&1 || true
	# The scheduled stop, start and restart from Other Settings, kept in the
	# crontab only while the main switch is on - as in PassWall2.
	"$ZGZ_LIB/zgz-router" schedule sync >/dev/null 2>&1 || true

	# The main switch, the way PassWall2 has it: this service is always
	# enabled at boot, and the switch is what decides whether it runs. Off is
	# off after a reboot too; on comes back on its own.
	if [ "$(cfg_bool enabled 0)" != "1" ]; then
		log "Main switch is off - not starting"
		return 0
	fi

	mkdir -p "$ZGZ_RUN" /var/etc "$ZGZ_ETC"
	log_trim
	log "Start running..."

	# A node chosen in Basic Settings is the node, at every start - including
	# the one that follows saving it there. Reading one link is quick enough
	# for this, unlike measuring.
	_fixed="$(cfg node '')"
	if [ -n "$_fixed" ]; then
		"$ZGZ_LIB/zgz-probe" use "$_fixed" >/dev/null 2>&1 ||
			log_step "The node chosen in Basic Settings cannot be read - keeping the last one"
	fi

	# Choosing a server is seconds of timed requests and must not happen here:
	# procd would be held for the whole measurement, and the service would be
	# neither started nor failed while it waited. zgz-connect does the
	# choosing and then calls us. At boot there is a choice from last time,
	# which is why it is kept in /etc and not in /var - and when there is
	# none, the switch is on and somebody has to choose, so it is handed to
	# the one thing that does, and this start ends here.
	if [ ! -s "$ZGZ_BEST" ]; then
		log_step "No node chosen yet - choosing one now"
		if command -v setsid >/dev/null 2>&1; then
			setsid "$ZGZ_LIB/zgz-connect" </dev/null >/dev/null 2>&1 &
		else
			( "$ZGZ_LIB/zgz-connect" </dev/null >/dev/null 2>&1 & ) &
		fi
		return 0
	fi
	log_step "Node: $(sed -n 's/^label=//p' "$ZGZ_BEST_META" 2>/dev/null | tail -1) [$(sed -n 's/^protocol=//p' "$ZGZ_BEST_META" 2>/dev/null | tail -1) $(sed -n 's/^host=//p' "$ZGZ_BEST_META" 2>/dev/null | tail -1):$(sed -n 's/^port=//p' "$ZGZ_BEST_META" 2>/dev/null | tail -1)]"

	if ! "$MKCONFIG" > "$ZGZ_CONFIG_JSON"; then
		log "could not write $ZGZ_CONFIG_JSON"
		return 1
	fi
	chmod 600 "$ZGZ_CONFIG_JSON"

	# Prefer a core the router already has; fall back to our own copy. The
	# candidate has to accept this exact configuration to be chosen, which is
	# a question no version number can answer.
	PROG="$(find_xray "$ZGZ_CONFIG_JSON")" || PROG=""

	# Refused by every core on the router. When the configuration named a geo
	# category, that is the likeliest reason and it is worth one more try
	# without: geoip.dat and geosite.dat found on a router are not necessarily
	# the pair this expects - another front-end's copy carries different
	# categories, and asking for one it has not got makes the core refuse the
	# whole file. Connected without the split beats not connected, as long as
	# the page says which of the two happened.
	if [ -z "$PROG" ] && grep -q 'geoip:ir\|geosite:ir\|geosite:category-ads-all' "$ZGZ_CONFIG_JSON" 2>/dev/null; then
		if "$MKCONFIG" nogeo > "$ZGZ_CONFIG_JSON.nogeo" 2>/dev/null &&
		   PROG="$(find_xray "$ZGZ_CONFIG_JSON.nogeo")"; then
			mv -f "$ZGZ_CONFIG_JSON.nogeo" "$ZGZ_CONFIG_JSON"
			chmod 600 "$ZGZ_CONFIG_JSON"
			log "the core would not read the routing data - connected with the Iran split off"
			say_message "The routing data on this router is not the pair this expects: the core refused geoip:ir and geosite:ir. Connected with the Iran split off. Press Update beside the routing data on the settings page to fetch the right files."
		else
			rm -f "$ZGZ_CONFIG_JSON.nogeo"
			PROG=""
		fi
	fi

	if [ -z "$PROG" ]; then
		log "no xray on this router can run the generated configuration"
		return 1
	fi
	# Which core, and which version of it, written down once here for the
	# status page - which asks every few seconds, and starting a core just to
	# ask it its version is not something to do every few seconds.
	_ver="$(core_version "$PROG")" || _ver=""
	printf 'name=xray\npath=%s\nversion=%s\n' "$PROG" "$_ver" > "$ZGZ_RUN/core.info" 2>/dev/null || true
	log_step "Core: Xray ${_ver:-?} ($PROG)"
	_gp="$(global_preproxy)" && log_step "Pre-proxy: $(uci -q get "zirgozar.$_gp.name" 2>/dev/null || echo "$_gp")"
	[ "$(cfg_bool fragment 0)" = "1" ] && log_step "Fragment: $(cfg fragment_packets tlshello), length $(cfg fragment_lengths '3-5,6-8,10-20'), delay $(cfg fragment_delays '10-20')"
	[ "$(cfg_bool noise 0)" = "1" ] && log_step "Noise: on"
	[ "$(cfg_bool mux 0)" = "1" ] && log_step "Mux: concurrency $(cfg mux_concurrency 8)"

	# A server speaking a protocol Xray does not know needs a second program
	# offering it as a local SOCKS port. It has to be running before the
	# tunnel is any use, so it is an instance of this same service and procd
	# keeps it alive on the same terms.
	if "$BRIDGE" needed 2>/dev/null; then
		if BRIDGE_CMD="$("$BRIDGE" command 2>/dev/null)"; then
			log_step "Bridge: $(sed -n 's/.*"type"[ \t]*:[ \t]*"\([^"]*\)".*/\1/p' "$ZGZ_ETC/bridge.json" 2>/dev/null | head -1) through $BRIDGE_CMD"
			_bbin="${BRIDGE_CMD%% *}"
			printf 'bridge=%s\nbridge_version=%s\n' "$_bbin" "$(core_version "$_bbin")" >> "$ZGZ_RUN/core.info" 2>/dev/null || true
			procd_open_instance bridge
			# shellcheck disable=SC2086
			procd_set_param command $BRIDGE_CMD
			procd_set_param respawn 3600 5 0
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
		else
			log "the chosen server needs a core this router does not have"
			return 1
		fi
	fi

	procd_open_instance zirgozar
	procd_set_param command "$PROG" run -config "$ZGZ_CONFIG_JSON"
	# Where geoip.dat and geosite.dat are. Empty is fine and normal: the
	# configuration only names geo categories when the files are there.
	_geo="$(geo_dir)" || _geo=""
	# The configuration's fingerprint goes in with it. procd replaces a
	# running instance only when what it was given has changed, and the file
	# name never does - so this is what tells it the core has something new
	# to read, and what leaves it alone when it has not.
	_sum="$(md5sum "$ZGZ_CONFIG_JSON" 2>/dev/null | cut -c1-32)"
	if [ -n "$_geo" ]; then
		procd_set_param env XRAY_LOCATION_ASSET="$_geo" ZGZ_CONFIG_SUM="$_sum"
	else
		procd_set_param env ZGZ_CONFIG_SUM="$_sum"
	fi
	# A router's default of 1024 open files is not many when every device on
	# the network has its connections held open by one process.
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 5 0
	# The core's own complaints are the only explanation there is when it will
	# not start, so let them reach the log.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/zirgozar.pid
	procd_close_instance

	touch "$STARTED_FLAG"
	return 0
}

# Is anything listening on this port? Ask three ways rather than one: a check
# that cannot see a healthy listener is indistinguishable from a tunnel that
# never came up, and it tears the tunnel down either way.
listening() {
	local hex
	hex=$(printf %04X "$1" 2>/dev/null)
	[ -n "$hex" ] || return 1
	grep -qi ":$hex " /proc/net/tcp  2>/dev/null && return 0
	grep -qi ":$hex " /proc/net/tcp6 2>/dev/null && return 0
	grep -qi ":$hex " /proc/net/udp  2>/dev/null && return 0
	netstat -ln 2>/dev/null | grep -q "[:.]$1[[:space:]]" && return 0
	return 1
}

wait_for_port() {
	local port="$1" limit="${2:-20}" n=0
	while [ "$n" -lt "$limit" ]; do
		listening "$port" && return 0
		n=$((n + 1))
		sleep 1
	done
	return 1
}

# Nothing is running yet when start_service returns: procd_open_instance only
# describes the service, and procd is not told to start it until rc.common
# calls procd_close_service afterwards. Waiting for the socket in there was
# waiting for a process nobody had started, so it always timed out and the
# tunnel could never come up. rc.common calls this hook after the service is
# actually running, which is where that wait belongs.
service_started() {
	local tproxy_port bridge_port

	# start_service decided not to start anything. Without this the wait below
	# would run its full course and report a failure about a tunnel nobody
	# asked for.
	[ -f "$STARTED_FLAG" ] || return 0

	tproxy_port="$(cfg tproxy_port 1082)"
	bridge_port="$(cfg bridge_port 10808)"

	if "$BRIDGE" needed 2>/dev/null; then
		if ! wait_for_port "$bridge_port" 15; then
			log "the bridge never started listening on $bridge_port"
			say_status failed
			say_message "The helper for this node's protocol would not start."
			return 1
		fi
	fi

	# The rules send every LAN packet to a port the core listens on, and name
	# lookups to another. Install them before it is listening and the whole
	# network has nowhere to go - no web, no DNS, and no obvious reason why.
	if ! wait_for_port "$tproxy_port" 20; then
		log "xray never started listening on $tproxy_port - leaving the network untouched"
		log "listening now: $(netstat -ln 2>/dev/null | awk '/LISTEN|udp/ { print $4 }' | tr '\n' ' ')"
		say_status failed
		say_message "The tunnel process started but never accepted connections. Check the system log for what it said."
		"$RULES" down >/dev/null 2>&1 || true
		return 1
	fi

	if ! "$RULES" up >/dev/null 2>&1; then
		log "could not install the routing rules - leaving the network untouched"
		say_status failed
		"$RULES" down >/dev/null 2>&1 || true
		return 1
	fi

	"$DNS" up >/dev/null 2>&1 || true

	# What was put in place, so that a save can tell whether it changes any
	# of it - see reload_service.
	"$RULES" dump > "$ZGZ_RUN/rules.applied" 2>/dev/null || rm -f "$ZGZ_RUN/rules.applied"
	dns_signature > "$ZGZ_RUN/dns.applied"

	# Take a first reading now, so the first real sample measures the traffic
	# since the tunnel came up rather than counting the core's start-up twice.
	"$STATS" sample >/dev/null 2>&1 || true

	log_step "Xray[$tproxy_port] transparent proxy, DNS[$(cfg dns_port 1053)], firewall: $("$RULES" status 2>/dev/null | sed -n 's/^backend:[ 	]*//p' | head -1)"
	say_status ready
	log "Running complete!"
	return 0
}

stop_service() {
	# Before anything is killed: the counters live inside the core and vanish
	# with it, so whatever has gone through since the last sample has to be
	# collected while it is still there to collect.
	"$STATS" sample >/dev/null 2>&1 || true
	"$STATS" flush >/dev/null 2>&1 || true

	"$DNS" down >/dev/null 2>&1 || true
	"$RULES" down >/dev/null 2>&1 || true
	rm -f "$ZGZ_CONFIG_JSON" "$STARTED_FLAG" "$ZGZ_RUN/core.info"
	log "Clearing and closing related programs complete."
	return 0
}

service_stopped() {
	say_status idle
	return 0
}

# What the DNS step depends on. Kept beside the ruleset for the same reason.
dns_signature() {
	echo "$(cfg dns_mode dnsmasq) $(cfg dns_port 1053)"
}

# A save. Every save on every page lands here, and restarting the tunnel for
# each one dropped every connection on the network for half a minute - for a
# changed language as much as for a changed node. So only what the save
# actually changes is redone:
#
#   nothing the tunnel uses      nothing at all
#   the firewall rules or DNS    those, with the core left running
#   the core's configuration     the new one is checked while the old core
#                                is still carrying traffic, then procd swaps
#                                the core alone; the rules and DNS stay up
#
# Anything else - the switch, a tunnel that is not up, a helper core for a
# hysteria2 or tuic node - goes the whole way round, as before.
reload_service() {
	if [ "$(cfg_bool enabled 0)" != "1" ] || [ ! -f "$STARTED_FLAG" ] ||
	   ! tunnel_running || "$BRIDGE" needed 2>/dev/null; then
		restart
		return
	fi

	"$ZGZ_LIB/zgz-router" rebind >/dev/null 2>&1 || true
	"$ZGZ_LIB/zgz-nodes" fixnames >/dev/null 2>&1 || true
	"$ZGZ_LIB/zgz-router" schedule sync >/dev/null 2>&1 || true
	_fixed="$(cfg node '')"
	if [ -n "$_fixed" ]; then
		"$ZGZ_LIB/zgz-probe" use "$_fixed" >/dev/null 2>&1 || true
	fi

	if ! "$MKCONFIG" > "$ZGZ_CONFIG_JSON.next" 2>/dev/null; then
		rm -f "$ZGZ_CONFIG_JSON.next"
		restart
		return
	fi
	_core=same
	cmp -s "$ZGZ_CONFIG_JSON.next" "$ZGZ_CONFIG_JSON" || _core=changed
	_rules=same
	"$RULES" dump 2>/dev/null | cmp -s - "$ZGZ_RUN/rules.applied" || _rules=changed
	_dns=same
	[ "$(dns_signature)" = "$(cat "$ZGZ_RUN/dns.applied" 2>/dev/null)" ] || _dns=changed

	if [ "$_core" = "changed" ]; then
		# Checked before anything stops: a configuration the core refuses
		# leaves the tunnel exactly as it was, still working.
		_prog="$(sed -n 's/^path=//p' "$ZGZ_RUN/core.info" 2>/dev/null | head -1)"
		_geo="$(geo_dir)" || _geo=""
		if [ -n "$_prog" ] && ! XRAY_LOCATION_ASSET="$_geo" bounded 60 "$_prog" run -test -config "$ZGZ_CONFIG_JSON.next" >/dev/null 2>&1; then
			rm -f "$ZGZ_CONFIG_JSON.next"
			log "the new settings were refused by the core - the tunnel is left as it was"
			say_message "The core refused the new settings, so the tunnel was left running as it was. Check the Runtime Logs page."
			return 1
		fi
		rm -f "$ZGZ_CONFIG_JSON.next"
		log "Settings saved - restarting the core only"
		# start, not restart: the service is already running, so procd swaps
		# the one instance whose configuration changed and nothing else is
		# stopped. service_started brings the rules and DNS up to date.
		start
		return
	fi
	rm -f "$ZGZ_CONFIG_JSON.next"

	if [ "$_rules" = "changed" ]; then
		"$RULES" up >/dev/null 2>&1 || { restart; return; }
		"$RULES" dump > "$ZGZ_RUN/rules.applied" 2>/dev/null || true
	fi
	if [ "$_dns" = "changed" ]; then
		"$DNS" down >/dev/null 2>&1 || true
		"$DNS" up >/dev/null 2>&1 || true
		dns_signature > "$ZGZ_RUN/dns.applied"
	fi
	if [ "$_rules$_dns" = "samesame" ]; then
		log "Settings saved - nothing the tunnel uses changed, so it was left running"
	else
		log "Settings saved - the firewall rules or DNS were updated, the core was left running"
	fi
	return 0
}

service_triggers() {
	procd_add_reload_trigger "zirgozar"
}
