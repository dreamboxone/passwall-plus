#
# zgz-geo - fetch the routing data the Iran split needs.
#
#   zgz-geo update [geoip|geosite|all]
#   zgz-geo rollback geoip|geosite
#   zgz-geo status
#   zgz-geo remove
#
# PassWall2's Rollback: the file an update replaces is kept, in memory, until
# the next reboot or the next update, and can be put back. In memory and not
# on flash, as PassWall2 keeps it, because two copies of seventeen megabytes
# on flash is exactly what a small router has not got - and only when there
# is room in memory to spare, because running out of it is worse still.
#
# Both addresses are settings, shown in the web interface and editable there.
# Pressing Update always downloads again, whether or not the file is already
# on the router - that is the point of a button called Update.
#
# Two things this refuses to do.
#
# It will not start a download that cannot fit. A router that fills its
# overlay does not simply fail to save the file: it remounts read-only, and
# from that moment nothing works and nothing says why. The full geoip.dat is
# about seventeen megabytes and geosite.dat about eight, which is more than
# the free space on a great many routers, so this is not a theoretical
# concern - it is the normal case.
#
# And it will not install a file it has not seen the core read. A download
# that returns an error page, a rate-limit notice or a login form is still a
# file, and it is still the right name and roughly the right size. Installed,
# it does not degrade anything: Xray refuses to start at all, and the router
# loses its internet connection because of a file that was meant to make
# routing cleverer. So the new file is put in front of the core, in place,
# before it is allowed to replace the old one.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

GEOIP_DEFAULT="https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip.dat"
GEOSITE_DEFAULT="https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geosite.dat"

DIR="$(cfg geo_dir "$ZGZ_ETC/geo")"
BAK="${ZGZ_GEO_BAK:-/tmp/zirgozar-geo-bak}"
# What must stay free in memory after a copy is kept.
BAK_MARGIN=33554432

url_for() {
	case "$1" in
		geoip)   cfg geoip_url "$GEOIP_DEFAULT" ;;
		geosite) cfg geosite_url "$GEOSITE_DEFAULT" ;;
	esac
	return 0
}

# Ask the core to read the pair, one of which is the newcomer.
#
# `geoip:ir` and `geosite:ir` are the two categories the split actually uses,
# so this is not a shape check - it is the same question the tunnel will ask
# thirty seconds from now, asked while there is still time to say no.
verify_pair() {
	_ip="$1"
	_site="$2"
	_x="$(find_xray '')" || {
		log "no core available to check the geo files with - installing them unchecked"
		return 0
	}

	_t="$ZGZ_RUN/geocheck"
	rm -rf "$_t"
	mkdir -p "$_t"
	# Symlinks would do, but a stripped busybox does not always have ln -s,
	# and these are read once and thrown away.
	cp -f "$_ip" "$_t/geoip.dat" 2>/dev/null || return 1
	cp -f "$_site" "$_t/geosite.dat" 2>/dev/null || return 1

	cat > "$_t/check.json" <<'EOF'
{
  "log": { "loglevel": "none" },
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "rules": [
      { "type": "field", "domain": [ "geosite:ir" ], "outboundTag": "direct" },
      { "type": "field", "ip": [ "geoip:ir" ], "outboundTag": "direct" }
    ]
  }
}
EOF

	if XRAY_LOCATION_ASSET="$_t" "$_x" run -test -config "$_t/check.json" >"$_t/err" 2>&1; then
		rm -rf "$_t"
		return 0
	fi
	warn "the downloaded geo data is not something the core can read: $(grep -o 'common/errors:.*' "$_t/err" | tail -1 | cut -c1-160)"
	rm -rf "$_t"
	return 1
}

fetch_one() {
	_what="$1"
	_url="$(url_for "$_what")"
	[ -n "$_url" ] || return 1

	_size="$(remote_size "$_url")"
	log "$_what: $_url ($(human_size "$_size"))"

	# Both files have to be in place before either can be checked, so the new
	# one is downloaded beside the target rather than over it.
	_new="$DIR/$_what.dat.new"
	mkdir -p "$DIR"
	download_checked "$_url" "$_new" "$_size" || return 1

	# The partner file: whichever is not being replaced this time round.
	if [ "$_what" = "geoip" ]; then
		_a="$_new"; _b="$DIR/geosite.dat"
	else
		_a="$DIR/geoip.dat"; _b="$_new"
	fi

	if [ -s "$_a" ] && [ -s "$_b" ]; then
		if ! verify_pair "$_a" "$_b"; then
			rm -f "$_new"
			say_message "The $_what file that came back is not readable routing data - the old one has been kept. Check the address."
			return 1
		fi
	fi

	keep_old "$_what"
	mv -f "$_new" "$DIR/$_what.dat" || return 1
	date -u +%s > "$DIR/$_what.stamp" 2>/dev/null || true
	log "$_what updated ($(human_size "$(wc -c < "$DIR/$_what.dat")"))"
	return 0
}

# The file about to be replaced, and when it was last replaced, kept for
# Rollback - when memory allows.
keep_old() {
	[ -s "$DIR/$1.dat" ] || return 0
	mkdir -p "$BAK" 2>/dev/null || return 0
	_sz="$(file_size "$DIR/$1.dat")"
	if [ "$(free_bytes "$BAK")" -lt $((_sz + BAK_MARGIN)) ]; then
		log "$1: not enough free memory to keep the old copy for rollback"
		rm -f "$BAK/$1.dat" "$BAK/$1.stamp"
		return 0
	fi
	if cp -f "$DIR/$1.dat" "$BAK/$1.dat" 2>/dev/null; then
		printf '%s\n' "$(stamped "$1")" > "$BAK/$1.stamp" 2>/dev/null || true
	else
		rm -f "$BAK/$1.dat" "$BAK/$1.stamp"
	fi
	return 0
}

# Put the kept copy back. It is checked with its partner first, the same as a
# download is, and it needs the same room on flash a download would.
cmd_rollback() {
	case "${1:-}" in
		geoip|geosite) : ;;
		*) echo "usage: $0 rollback geoip|geosite" >&2; return 1 ;;
	esac
	_what="$1"
	[ -s "$BAK/$_what.dat" ] || { warn "$_what: no earlier copy to go back to"; return 1; }
	space_for "$(file_size "$BAK/$_what.dat")" "$DIR" || return 1
	if [ "$_what" = "geoip" ]; then
		_a="$BAK/geoip.dat"; _b="$DIR/geosite.dat"
	else
		_a="$DIR/geoip.dat"; _b="$BAK/geosite.dat"
	fi
	if [ -s "$_a" ] && [ -s "$_b" ] && ! verify_pair "$_a" "$_b"; then
		say_message "The earlier $_what file is not readable routing data any more - kept the current one."
		return 1
	fi
	cp -f "$BAK/$_what.dat" "$DIR/$_what.dat.new" || { rm -f "$DIR/$_what.dat.new"; return 1; }
	mv -f "$DIR/$_what.dat.new" "$DIR/$_what.dat" || return 1
	if [ -s "$BAK/$_what.stamp" ]; then
		cp -f "$BAK/$_what.stamp" "$DIR/$_what.stamp" 2>/dev/null || true
	fi
	rm -f "$BAK/$_what.dat" "$BAK/$_what.stamp"
	log "$_what: rolled back to the earlier copy - reconnect for it to take effect"
	return 0
}

cmd_update() {
	clear_message
	_rc=0
	case "${1:-all}" in
		geoip)   fetch_one geoip   || _rc=1 ;;
		geosite) fetch_one geosite || _rc=1 ;;
		all)
			# Both, and both are attempted even when the first fails: a
			# partial result is more useful than none, and the pair check
			# above already refuses to install a broken half.
			fetch_one geoip   || _rc=1
			fetch_one geosite || _rc=1
			;;
		*) echo "usage: $0 update [geoip|geosite|all]" >&2; exit 1 ;;
	esac

	# Nothing is said here when it worked. The settings page shows its own
	# notice when the button is pressed, and a message written to the file
	# the Status page reads would sit on the front page afterwards saying
	# something that was true a week ago.
	if [ "$_rc" = "0" ]; then
		log "routing data updated - reconnect for it to take effect"
	fi
	return "$_rc"
}

# When the file was last replaced. The stamp beside it is written every time
# this program downloads one, and it is the answer wherever there is one. A
# file that arrived some other way - copied in by hand, left behind by an
# earlier version that did not write stamps, or found in another front-end's
# directory - has no stamp, and the page then showed nothing beside it, which
# reads as "never updated" rather than "not known". The filesystem knows when
# it was last written, so ask it.
stamped() {
	_st="$DIR/$1.stamp"
	if [ -s "$_st" ]; then
		_v="$(cat "$_st" 2>/dev/null)"
		case "$_v" in
			''|*[!0-9]*) : ;;
			*) echo "$_v"; return 0 ;;
		esac
	fi
	# busybox date takes -r. A build without it falls back to nothing rather
	# than to a wrong date.
	_v="$(date -r "$DIR/$1.dat" +%s 2>/dev/null)" || _v=""
	case "$_v" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$_v" ;;
	esac
	return 0
}

one_status() {
	_what="$1"
	_f="$DIR/$_what.dat"
	if [ -s "$_f" ]; then
		printf '"%s":{"present":true,"bytes":%s,"updated":%s,"url":"%s","backup":%s}' \
			"$_what" "$(file_size "$_f")" \
			"$(stamped "$_what")" \
			"$(json_escape "$(url_for "$_what")")" \
			"$([ -s "$BAK/$_what.dat" ] && echo true || echo false)"
	else
		printf '"%s":{"present":false,"bytes":0,"updated":0,"url":"%s","backup":%s}' \
			"$_what" "$(json_escape "$(url_for "$_what")")" \
			"$([ -s "$BAK/$_what.dat" ] && echo true || echo false)"
	fi
	return 0
}

cmd_status() {
	printf '{"dir":"%s","free":%s,' "$(json_escape "$DIR")" "$(free_bytes "$DIR")"
	one_status geoip
	printf ','
	one_status geosite
	printf ',"usable":%s}\n' "$(geo_dir >/dev/null 2>&1 && echo true || echo false)"
	return 0
}

# PassWall2's Geo View, with its tool.
#
#   view lookup <name or address>   which lists hold it - and which shunt
#                                   rules name one of those lists, or it
#   view extract geoip:<list>|geosite:<list>   what one list holds
#
# Prints the answer, then a line "--rules--" and the rules that contain it.
# A list can be tens of thousands of lines; the page is given the first
# five thousand.
cmd_view() {
	_bin="$(find_geoview)" || { echo "@nogeoview"; return 1; }
	[ -s "$DIR/geoip.dat" ] && [ -s "$DIR/geosite.dat" ] || { echo "@nogeo"; return 1; }
	_v="$(printf '%s' "${2:-}" | tr -d ' \t\r\n')"
	case "$_v" in
		''|*[!A-Za-z0-9.:/_@!-]*) echo "@bad"; return 1 ;;
	esac
	case "${1:-}" in
		lookup)
			_t=geosite
			case "$_v" in
				*[!0-9.]*) : ;;
				*.*.*.*) _t=geoip ;;
			esac
			case "$_v" in
				*:*) [ -z "$(printf '%s' "$_v" | tr -d '0-9A-Fa-f:.')" ] && _t=geoip ;;
			esac
			"$_bin" -type "$_t" -action lookup -input "$DIR/$_t.dat" -value "$_v" -lowmem=true 2>/dev/null |
				tr 'A-Z' 'a-z' | sed "s/^/$_t:/" > "$ZGZ_RUN/geoview.out"
			cat "$ZGZ_RUN/geoview.out"
			echo "--rules--"
			# The shunt rules that name one of those lists, or the value itself.
			{ cat "$ZGZ_RUN/geoview.out"; echo "$_v"; } > "$ZGZ_RUN/geoview.want"
			uci -q -X show zirgozar 2>/dev/null |
				sed -n "s/^zirgozar\.\([A-Za-z0-9_]*\)=shunt_rules\$/\1/p" | while read -r _r; do
					{ uci -q get "zirgozar.$_r.domain_list"; uci -q get "zirgozar.$_r.ip_list"; } 2>/dev/null |
						sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
						grep -qxFf "$ZGZ_RUN/geoview.want" || continue
					_g="$(uci -q get "zirgozar.$_r.group")" || _g=""
					printf '[%s]%s\n' "${_g:-default}" "$(uci -q get "zirgozar.$_r.remarks" || echo "$_r")"
				done
			rm -f "$ZGZ_RUN/geoview.out" "$ZGZ_RUN/geoview.want"
			;;
		extract)
			case "$_v" in
				geoip:?*)   _t=geoip ;;
				geosite:?*) _t=geosite ;;
				*) echo "@bad"; return 1 ;;
			esac
			"$_bin" -type "$_t" -action extract -input "$DIR/$_t.dat" -list "${_v#*:}" -lowmem=true 2>/dev/null |
				head -n 5000
			echo "--rules--"
			;;
		*) echo "@bad"; return 1 ;;
	esac
	return 0
}

cmd_remove() {
	rm -f "$DIR/geoip.dat" "$DIR/geosite.dat" "$DIR/geoip.stamp" "$DIR/geosite.stamp"
	log "routing data removed"
	return 0
}

case "${1:-status}" in
	update)   cmd_update "${2:-all}" ;;
	rollback) cmd_rollback "${2:-}" ;;
	status)   cmd_status ;;
	view)     cmd_view "${2:-}" "${3:-}" ;;
	remove)   cmd_remove ;;
	*) echo "usage: $0 update [geoip|geosite|all]|rollback geoip|geosite|status|remove" >&2; exit 1 ;;
esac
