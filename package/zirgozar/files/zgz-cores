# Part of Zirgozar - https://github.com/dreamboxone/zirgozar
#
# zgz-cores - install, update and remove the proxy engines.
#
#   zgz-cores list
#   zgz-cores install xray|sing-box|hysteria
#   zgz-cores install zirgozar       (this program, from its latest release)
#   zgz-cores remove  sing-box|hysteria
#
# Xray is the engine. It is what the configuration generator writes for, what
# the measurements run through, and what carries the traffic, and one copy of
# it ships with this package so that a fresh router works without downloading
# anything.
#
# sing-box and hysteria are here for the protocols Xray does not speak -
# hysteria2 and tuic. They are not a second engine: zgz-bridge runs one of
# them as a local SOCKS port for a single server, and Xray reaches it through
# an ordinary socks outbound. That way there is one routing engine, one DNS
# arrangement and one set of firewall rules no matter which protocol the
# chosen server happens to use, instead of two of everything.
#
# Nothing here touches /usr/bin/xray. That belongs to OpenWrt's xray-core
# package, which PassWall2 and others pull in, and a router that already has
# one is a router that needs nothing downloaded at all - find_xray will use
# it. Installing over it, or removing it, would break the other program.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

DIR="$(cfg core_dir "$ZGZ_OWN_DIR")"

XRAY_REPO=XTLS/Xray-core
SINGBOX_REPO=SagerNet/sing-box
HYSTERIA_REPO=apernet/hysteria
GEOVIEW_REPO=snowie2000/geoview

asset_for() {
	_a="$(arch_assets)"
	case "$1" in
		xray)     echo "$_a" | awk '{print $1}' ;;
		sing-box) echo "$_a" | awk '{print $2}' ;;
		hysteria) echo "$_a" | awk '{print $3}' ;;
		# Geoview names its builds the way sing-box does, but for "i386".
		geoview)  echo "$_a" | awk '{ print ($2 == "386") ? "i386" : $2 }' ;;
	esac
	return 0
}

latest_tag() {
	curl -fsSL --connect-timeout 15 --max-time 45 \
		"https://api.github.com/repos/$1/releases/latest" 2>/dev/null |
		sed -n 's/.*"tag_name"[ \t]*:[ \t]*"\([^"]*\)".*/\1/p' | head -1
	return 0
}

# Every archive needs room for itself and for what comes out of it, and the
# check has to happen against the filesystem it will actually land on.
need_room() {
	space_for "$1" "${2:-$DIR}"
	return $?
}

# ------------------------------------------------------------------- xray

install_xray() {
	_asset="$(asset_for xray)"
	[ "$_asset" != "-" ] && [ -n "$_asset" ] || {
		say_message "Xray publishes no build for this router's processor ($(openwrt_arch)$(uname -m))."
		return 1
	}
	_url="https://github.com/$XRAY_REPO/releases/latest/download/Xray-linux-$_asset.zip"
	_zip="$ZGZ_RUN/xray.zip"

	command -v unzip >/dev/null 2>&1 || {
		say_message "unzip is needed to install Xray and is not on this router. Press Install dependencies on the settings page."
		return 1
	}

	_size="$(remote_size "$_url")"
	# the archive, plus the binary that comes out of it
	need_room $((_size * 2)) || return 1

	download_checked "$_url" "$_zip" "$_size" || return 1

	rm -rf "$ZGZ_RUN/xtract"
	mkdir -p "$ZGZ_RUN/xtract"
	if ! unzip -o -q "$_zip" xray -d "$ZGZ_RUN/xtract" 2>/dev/null; then
		rm -f "$_zip"
		rm -rf "$ZGZ_RUN/xtract"
		say_message "The Xray download did not contain a program - the address or the release may have changed."
		return 1
	fi
	rm -f "$_zip"
	install_binary "$ZGZ_RUN/xtract/xray" "$DIR/xray" xray
	return $?
}

# ---------------------------------------------------------------- sing-box

install_singbox() {
	_asset="$(asset_for sing-box)"
	[ "$_asset" != "-" ] && [ -n "$_asset" ] || {
		say_message "sing-box publishes no build for this router's processor."
		return 1
	}
	_tag="$(latest_tag "$SINGBOX_REPO")"
	[ -n "$_tag" ] || {
		say_message "Could not reach GitHub to find out which sing-box is current. Connect the tunnel first, then try again."
		return 1
	}
	_ver="${_tag#v}"
	# The archive name carries the version, so unlike the others this one
	# cannot be fetched from the /latest/download/ path without asking first.
	_name="sing-box-$_ver-linux-$_asset"
	_url="https://github.com/$SINGBOX_REPO/releases/download/$_tag/$_name.tar.gz"
	_tgz="$ZGZ_RUN/sing-box.tar.gz"

	_size="$(remote_size "$_url")"
	need_room $((_size * 3)) "$(dirname "$(singbox_path)")" || return 1
	download_checked "$_url" "$_tgz" "$_size" || return 1

	rm -rf "$ZGZ_RUN/xtract"
	mkdir -p "$ZGZ_RUN/xtract"
	if ! tar -xzf "$_tgz" -C "$ZGZ_RUN/xtract" 2>/dev/null; then
		rm -f "$_tgz"; rm -rf "$ZGZ_RUN/xtract"
		say_message "The sing-box download could not be unpacked."
		return 1
	fi
	rm -f "$_tgz"
	_bin="$(find "$ZGZ_RUN/xtract" -name sing-box -type f 2>/dev/null | head -1)"
	[ -n "$_bin" ] || { rm -rf "$ZGZ_RUN/xtract"; say_message "No sing-box program inside the archive."; return 1; }
	install_binary "$_bin" "$(singbox_path)" sing-box
	return $?
}

# ---------------------------------------------------------------- hysteria

install_hysteria() {
	_asset="$(asset_for hysteria)"
	[ "$_asset" != "-" ] && [ -n "$_asset" ] || {
		say_message "hysteria publishes no build for this router's processor."
		return 1
	}
	# A plain executable, not an archive.
	_url="https://github.com/$HYSTERIA_REPO/releases/latest/download/hysteria-linux-$_asset"
	# _bin, not _tmp: the other two installers name their download for what it
	# is, and this one did not - which is how it came to hand a helper the one
	# variable name that helper was about to reuse.
	_bin="$ZGZ_RUN/hysteria.bin"

	_size="$(remote_size "$_url")"
	need_room $((_size * 2)) "$(dirname "$(hysteria_path)")" || return 1
	download_checked "$_url" "$_bin" "$_size" || return 1
	install_binary "$_bin" "$(hysteria_path)" hysteria
	return $?
}

# ----------------------------------------------------------------- geoview

install_geoview() {
	_asset="$(asset_for geoview)"
	[ "$_asset" != "-" ] && [ -n "$_asset" ] || {
		say_message "Geoview publishes no build for this router's processor."
		return 1
	}
	# A plain executable, like hysteria.
	_url="https://github.com/$GEOVIEW_REPO/releases/latest/download/geoview-linux-$_asset"
	_bin="$ZGZ_RUN/geoview.bin"

	_size="$(remote_size "$_url")"
	need_room $((_size * 2)) "$(dirname "$(geoview_path)")" || return 1
	download_checked "$_url" "$_bin" "$_size" || return 1
	install_binary "$_bin" "$(geoview_path)" geoview
	return $?
}

# ------------------------------------------------------------------ common

# Put it in place only once it has been seen to run. A download for the wrong
# processor is the right size, the right name and completely inert, and it
# would sit there looking installed until the day something tried to use it.
# Is this an ELF at all, and is it for this machine?
#
# Asked of the file rather than guessed at from the failure. Bytes 0 to 3 of
# an ELF header are the magic, 4 and 5 are its word size and byte order, and
# 18 and 19 are the processor it was built for - so comparing those against a
# program this router is already running answers the question outright.
#
# With dd and cmp, because that is what is actually here. A router's busybox
# may be built without od, without hexdump and without cksum - this one has no
# od and no cksum - and a check written on top of a missing tool does not fail
# loudly, it compares one empty string with another and says yes to anything.
elf_slice() {   # elf_slice <file> <destination> <offset> <length>
	dd if="$1" bs=1 skip="$3" count="$4" of="$2" 2>/dev/null || return 1
	[ -s "$2" ] || return 1
	return 0
}

is_elf() {
	[ -s "$1" ] || return 1
	_want="$ZGZ_RUN/.elf.want"
	_got="$ZGZ_RUN/.elf.got"
	printf '\177ELF' > "$_want" 2>/dev/null || { rm -f "$_want"; return 0; }
	if ! elf_slice "$1" "$_got" 0 4; then
		rm -f "$_want" "$_got"
		return 1
	fi
	if cmp -s "$_want" "$_got"; then _r=0; else _r=1; fi
	rm -f "$_want" "$_got"
	return "$_r"
}

same_arch() {
	_ref=/bin/busybox
	[ -r "$_ref" ] || _ref=/bin/sh
	# Nothing to compare against is not a reason to refuse a download.
	[ -r "$_ref" ] || return 0
	_a="$ZGZ_RUN/.elf.a"
	_b="$ZGZ_RUN/.elf.b"
	rm -f "$_a" "$_b"
	for _off in 4 18; do
		_len=2
		if ! elf_slice "$1" "$_a.part" "$_off" "$_len"; then rm -f "$_a" "$_b" "$_a.part"; return 0; fi
		if ! elf_slice "$_ref" "$_b.part" "$_off" "$_len"; then rm -f "$_a" "$_b" "$_a.part" "$_b.part"; return 0; fi
		cat "$_a.part" >> "$_a"
		cat "$_b.part" >> "$_b"
		rm -f "$_a.part" "$_b.part"
	done
	if cmp -s "$_a" "$_b"; then _r=0; else _r=1; fi
	rm -f "$_a" "$_b"
	return "$_r"
}

install_binary() {
	_src="$1"; _dst="$2"; _name="$3"
	mkdir -p "$(dirname "$_dst")"
	chmod 0755 "$_src" 2>/dev/null || true

	# Geoview answers -version; the cores answer version.
	_vflag=version
	[ "$_name" = "geoview" ] && _vflag=-version
	if ! "$_src" "$_vflag" >/dev/null 2>&1; then
		# Three different things used to be reported as one, and the one was a
		# guess: "probably built for a different processor". It is the least
		# likely of the three, because the address the file came from is
		# chosen from this router's own architecture - and saying it sends the
		# reader looking for a build that is already the right build.
		if ! is_elf "$_src"; then
			_why="what came back is not a program at all - the address may have moved, or answered with an error page"
		elif ! same_arch "$_src"; then
			_why="it is built for a different processor than this router"
		else
			_why="it is built for this processor but would not start: $("$_src" version 2>&1 | head -1)"
		fi
		rm -f "$_src"
		rm -rf "$ZGZ_RUN/xtract"
		say_message "The $_name that was downloaded could not be installed - $_why."
		warn "$_name downloaded but will not run here: $_why"
		return 1
	fi

	# Replacing a running program in place fails on a busy filesystem; moving
	# the old one aside first does not.
	if [ -e "$_dst" ]; then
		mv -f "$_dst" "$_dst.old" 2>/dev/null || true
	fi
	if mv -f "$_src" "$_dst" 2>/dev/null || cp -f "$_src" "$_dst"; then
		chmod 0755 "$_dst"
		rm -f "$_dst.old"
		rm -rf "$ZGZ_RUN/xtract"
		log "$_name $(core_version "$_dst") installed in $_dst"
		return 0
	fi
	# put back what was there
	[ -e "$_dst.old" ] && mv -f "$_dst.old" "$_dst" 2>/dev/null || true
	rm -rf "$ZGZ_RUN/xtract"
	say_message "Could not write $_dst."
	return 1
}

# -------------------------------------------------------------------- list

# What each project has published, as last seen. Read from a file and never
# from the network: this is printed for a page that polls every few seconds,
# and asking GitHub three times on every poll would be both rude and slow.
# `zgz-cores latest` is what refreshes it, in the background.
LATEST_CACHE="$ZGZ_ETC/cores.latest"
LATEST_MAX_AGE=43200        # twelve hours

latest_of() {
	sed -n "s/^$1	//p" "$LATEST_CACHE" 2>/dev/null | head -1
	return 0
}

repo_of() {
	case "$1" in
		xray)     echo "$XRAY_REPO" ;;
		sing-box) echo "$SINGBOX_REPO" ;;
		hysteria) echo "$HYSTERIA_REPO" ;;
		geoview)  echo "$GEOVIEW_REPO" ;;
		zirgozar) echo "dreamboxone/zirgozar" ;;
	esac
	return 0
}

# The published version, normalised to what the core itself prints so the two
# can be compared at all: a tag is "v26.7.28" or "app/v2.12.2", and the binary
# says "26.7.28" or "v2.12.2".
tag_version() {
	_t="$1"
	_t="${_t##*/}"
	echo "$_t"
	return 0
}

cmd_latest() {
	# Refresh only when it is old, unless asked to do it anyway. Three small
	# requests twice a day is nothing; three on every page poll is a habit
	# that gets a router rate-limited.
	if [ "${1:-}" != "force" ] && [ -s "$LATEST_CACHE" ]; then
		_age=$(( $(date +%s) - $(date -r "$LATEST_CACHE" +%s 2>/dev/null || echo 0) ))
		[ "$_age" -ge 0 ] && [ "$_age" -lt "$LATEST_MAX_AGE" ] && return 0
	fi

	_tmp="$LATEST_CACHE.new"
	: > "$_tmp"
	for _c in xray sing-box hysteria geoview zirgozar; do
		_repo="$(repo_of "$_c")"
		[ -n "$_repo" ] || continue
		# The tag is all that is wanted, so this is a small request and a
		# short leash. A source that will not answer leaves the previous
		# answer in place rather than blanking it.
		_tag="$(curl -fsSL --connect-timeout 8 --max-time 20 \
			"https://api.github.com/repos/$_repo/releases/latest" 2>/dev/null |
			sed -n 's/.*"tag_name"[ \t]*:[ \t]*"\([^"]*\)".*/\1/p' | head -1)"
		if [ -n "$_tag" ]; then
			printf '%s\t%s\n' "$_c" "$(tag_version "$_tag")" >> "$_tmp"
		else
			_old="$(latest_of "$_c")"
			[ -n "$_old" ] && printf '%s\t%s\n' "$_c" "$_old" >> "$_tmp"
		fi
	done
	if [ -s "$_tmp" ]; then
		mv -f "$_tmp" "$LATEST_CACHE"
	else
		rm -f "$_tmp"
	fi
	return 0
}

one() {
	_name="$1"; _path="$2"
	_latest="$(latest_of "$_name")"
	if [ -n "$_path" ] && [ -x "$_path" ]; then
		_have="$(core_version_cached "$_path")"
		# Different strings, not "newer": comparing version numbers written by
		# three different projects is a way to be confidently wrong. The page
		# shows both and the reader decides.
		_new=false
		if [ -n "$_latest" ] && [ -n "$_have" ] && \
		   [ "${_latest#v}" != "${_have#v}" ]; then
			_new=true
		fi
		printf '{"name":"%s","installed":true,"path":"%s","version":"%s","latest":"%s","update":%s,"bytes":%s,"ours":%s,"arch_ok":%s}' \
			"$_name" "$(json_escape "$_path")" \
			"$(json_escape "$_have")" \
			"$(json_escape "$_latest")" "$_new" \
			"$(file_size "$_path")" \
			"$(case "$_path" in "$DIR"/*|"$(singbox_path)"|"$(hysteria_path)"|"$(geoview_path)") echo true ;; *) echo false ;; esac)" \
			"$([ "$(asset_for "$_name")" != "-" ] && echo true || echo false)"
	else
		printf '{"name":"%s","installed":false,"path":"","version":"","latest":"%s","update":false,"bytes":0,"ours":false,"arch_ok":%s}' \
			"$_name" "$(json_escape "$_latest")" \
			"$([ "$(asset_for "$_name")" != "-" ] && echo true || echo false)"
	fi
	return 0
}

cmd_list() {
	# Found without starting any of them - see xray_installed. The versions
	# come from the cache in core_version_cached for the same reason.
	_x="$(xray_installed 2>/dev/null)" || _x=""
	_s="$(singbox_path)"; [ -x "$_s" ] || _s=""
	_h="$(hysteria_path)"; [ -x "$_h" ] || _h=""
	_g="$(geoview_path)"; [ -x "$_g" ] || _g=""
	printf '{"dir":"%s","free":%s,"arch":"%s","cores":[' \
		"$(json_escape "$DIR")" "$(free_bytes "$DIR")" \
		"$(json_escape "$(openwrt_arch)")"
	one xray "$_x"; printf ','
	one sing-box "$_s"; printf ','
	one hysteria "$_h"; printf ','
	one geoview "$_g"
	# This program itself, for the App Update page: what is installed and
	# what has been published. It is updated by installing the new package,
	# not from here - a package manager is the only thing that can replace a
	# package cleanly - so this only says whether there is one to install.
	_mine="$(zgz_version)"; _mine="${_mine%-r*}"
	_pub="$(latest_of zirgozar)"
	printf '],"app":{"version":"%s","latest":"%s","update":%s}}\n' \
		"$(json_escape "$_mine")" "$(json_escape "${_pub#v}")" \
		"$([ -n "$_pub" ] && [ "${_pub#v}" != "$_mine" ] && echo true || echo false)"
	return 0
}

# ---------------------------------------------------------- this program

# The newest release of this program, put in the way it was put in the first
# time: its two packages, handed to the router's own package manager. Only
# the package manager can replace a package cleanly - it knows which files
# are whose, keeps the settings file, and runs the steps that go with an
# upgrade - so this does no more than fetch the right two files for this
# router, check them against the release's own list of checksums, and ask it.
#
# How it went is left in SELF_RESULT for the page: "ok <version>" or
# "error <why>". The page cannot be told any other way, because the install
# restarts the very service it would be asking.
SELF_REPO=dreamboxone/zirgozar
SELF_RESULT="$ZGZ_RUN/self-update"
SELF_DIR=/tmp/zirgozar-update

self_fail() {
	printf 'error %s\n' "$1" > "$SELF_RESULT"
	warn "update: $1"
	rm -rf "$SELF_DIR"
	return 1
}

install_self() {
	rm -f "$SELF_RESULT"
	_arch="$(openwrt_arch)"
	[ -n "$_arch" ] || { self_fail "This router does not say what processor it has."; return 1; }
	if command -v apk >/dev/null 2>&1; then
		_pm=apk
	elif command -v opkg >/dev/null 2>&1; then
		_pm=opkg
	else
		self_fail "No package manager found on this router."
		return 1
	fi

	# Every download address in the release, one per line. The answer may
	# come on one line or many, so it is split on commas first.
	_urls="$(curl -fsSL --connect-timeout 15 --max-time 45 \
		"https://api.github.com/repos/$SELF_REPO/releases/latest" 2>/dev/null |
		tr ',' '\n' |
		sed -n 's/.*"browser_download_url"[ \t]*:[ \t]*"\([^"]*\)".*/\1/p')"
	[ -n "$_urls" ] || { self_fail "GitHub could not be reached."; return 1; }

	if [ "$_pm" = "apk" ]; then
		_main="$(printf '%s\n' "$_urls" | grep "/zirgozar-[^/]*\.$_arch\.apk\$" | head -1)"
		_luci="$(printf '%s\n' "$_urls" | grep '/luci-app-zirgozar-[^/]*\.apk$' | head -1)"
	else
		_main="$(printf '%s\n' "$_urls" | grep "/zirgozar_[^/]*_$_arch\.ipk\$" | head -1)"
		_luci="$(printf '%s\n' "$_urls" | grep '/luci-app-zirgozar_[^/]*_all\.ipk$' | head -1)"
	fi
	_sums="$(printf '%s\n' "$_urls" | grep '/SHA256SUMS$' | head -1)"
	[ -n "$_main" ] || { log "update: no package for $_arch in the latest release"; self_fail "The latest release has no package for this router."; return 1; }
	[ -n "$_luci" ] && [ -n "$_sums" ] || { self_fail "The latest release is incomplete."; return 1; }

	rm -rf "$SELF_DIR"
	mkdir -p "$SELF_DIR"
	log "update: downloading $(basename "$_main")"
	download_checked "$_main" "$SELF_DIR/$(basename "$_main")" || { self_fail "Download failed."; return 1; }
	download_checked "$_luci" "$SELF_DIR/$(basename "$_luci")" || { self_fail "Download failed."; return 1; }
	# Far smaller than download_checked's floor for a real file, so fetched
	# plainly.
	curl -fsSL --connect-timeout 15 --max-time 60 -o "$SELF_DIR/SHA256SUMS" "$_sums" 2>/dev/null ||
		{ self_fail "Download failed."; return 1; }

	for _f in "$SELF_DIR/$(basename "$_main")" "$SELF_DIR/$(basename "$_luci")"; do
		_n="$(basename "$_f")"
		_want="$(awk -v n="$_n" '$2 == n || $2 == "*" n { print $1; exit }' "$SELF_DIR/SHA256SUMS")"
		_got="$(sha256sum "$_f" 2>/dev/null | awk '{ print $1 }')"
		if [ -z "$_want" ] || [ "$_want" != "$_got" ]; then
			log "update: $_n does not match SHA256SUMS"; self_fail "A downloaded file does not match the release's checksum - nothing was installed."
			return 1
		fi
	done

	log "update: installing with $_pm"
	# The release is not signed with a key this router knows, so apk has to
	# be told to take it; the checksums above are what vouch for it. The
	# `|| _rc=$?` because under set -e a bare failure would end the script
	# before it could say why.
	_rc=0
	if [ "$_pm" = "apk" ]; then
		apk add --allow-untrusted "$SELF_DIR/$(basename "$_main")" "$SELF_DIR/$(basename "$_luci")" \
			>"$SELF_DIR/log" 2>&1 || _rc=$?
	else
		opkg install "$SELF_DIR/$(basename "$_main")" "$SELF_DIR/$(basename "$_luci")" \
			>"$SELF_DIR/log" 2>&1 || _rc=$?
	fi
	if [ "$_rc" != "0" ]; then
		log "update: $_pm said: $(tail -n 3 "$SELF_DIR/log" | tr '\n' ' ')"
		self_fail "The package manager refused the new version. The Log page has the details."
		return 1
	fi

	# The version file lives in /etc, and a package manager leaves a file
	# there that has changed since it was installed and puts the new one
	# beside it. It is not a setting; the new one is the true one.
	for _v in "$ZGZ_ETC/version.apk-new" "$ZGZ_ETC/version-opkg"; do
		if [ -f "$_v" ]; then
			mv -f "$_v" "$ZGZ_ETC/version"
		fi
	done

	# An upgrade may stop the tunnel on its way through. The main switch
	# decides whether it comes back, as it does at boot.
	/etc/init.d/zirgozar enable >/dev/null 2>&1 || true
	/etc/init.d/zirgozar restart >/dev/null 2>&1 || true
	rm -rf "$SELF_DIR"
	_now="$(zgz_version)"
	printf 'ok %s\n' "${_now%-r*}" > "$SELF_RESULT"
	log "update: now version $_now"
	return 0
}

cmd_remove() {
	case "$1" in
		sing-box|hysteria|geoview)
			# Only ever our own copy - the one at its App Path. Something
			# else on this router installed anything else, and it is not
			# ours to delete.
			case "$1" in
				sing-box) _rm="$(singbox_path)" ;;
				hysteria) _rm="$(hysteria_path)" ;;
				*)        _rm="$(geoview_path)" ;;
			esac
			if [ -e "$_rm" ]; then
				rm -f "$_rm"
				log "$1 removed"
			fi
			;;
		xray)
			say_message "Xray is the engine and cannot be removed - it can only be updated."
			return 1
			;;
		*) echo "usage: $0 remove sing-box|hysteria|geoview" >&2; return 1 ;;
	esac
	return 0
}

case "${1:-list}" in
	list) cmd_list ;;
	install)
		clear_message
		case "${2:-}" in
			xray)     install_xray ;;
			sing-box) install_singbox ;;
			hysteria) install_hysteria ;;
			geoview)  install_geoview ;;
			# This file is among those the install replaces, so nothing
			# after it may be read from here: it ends the script outright.
