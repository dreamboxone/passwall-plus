#
# pwplus-deps - make sure the router has what this needs, on its own.
#
#   pwplus-deps check     what is missing, and what actually works  (JSON)
#   pwplus-deps install   install whatever is missing
#
# The package metadata already declares these, so a normal install pulls them
# in. This exists for the cases where that is not enough: a package installed
# by hand from a release page, an image built without the kernel modules, an
# upgrade that dropped one. None of it assumes PassWall2 or anything else has
# already been here - it is a fresh OpenWrt that has to work.
#
# It reports two different things, and the difference matters. A package can
# be installed and the thing it provides still not work - a kernel module for
# a kernel that was replaced, an `ip` that is really busybox wearing the name.
# So there is a list of missing packages, and separately a set of questions
# put to the running system: can it transparently proxy, can it do policy
# routing, can it fetch over HTTPS. It is the second set that decides whether
# the tunnel will work, and it is the second set the page shows first.
#
# Nothing here installs, removes or upgrades xray-core. A router that already
# has one - because PassWall2 put it there - is a router that needs nothing,
# and touching that package would break the other program for no gain.

set -e

. "${PWPLUS_LIB:-/usr/libexec}/pwplus-common.sh"

pkg_manager() {
	if command -v apk >/dev/null 2>&1 && [ -d /lib/apk ]; then
		echo apk
	elif command -v opkg >/dev/null 2>&1; then
		echo opkg
	else
		echo none
	fi
	return 0
}

# What is needed, given how this router does firewalling.
wanted() {
	echo "curl ca-bundle ip-full"
	case "$(firewall_backend)" in
		nft) echo "kmod-nft-tproxy kmod-nft-socket" ;;
		ipt) echo "iptables-mod-tproxy iptables-mod-conntrack-extra" ;;
	esac
	# only needed to install a core later, so not worth failing over
	echo "unzip"
	return 0
}

installed() {
	case "$(pkg_manager)" in
		apk)  apk info -e "$1" 2>/dev/null | grep -q . ;;
		opkg) opkg list-installed "$1" 2>/dev/null | grep -q . ;;
		*) return 1 ;;
	esac
	return $?
}

missing() {
	for _p in $(wanted); do
		installed "$_p" || echo "$_p"
	done
	return 0
}

# ------------------------------------------------------------- does it work

# Not "is iproute2 installed" but "is the `ip` on the path the real one".
# busybox provides a cut-down `ip` under the same name that cannot add a local
# route, and that failure shows up as a tunnel which loads every rule
# perfectly and carries nothing.
have_ip_full() {
	ip -V 2>&1 | grep -qi 'iproute2'
	return $?
}

# The one that catches a fresh router with no certificates: every address this
# program fetches from is HTTPS, and without ca-bundle curl refuses them all
# with an error most people read as "the site is blocked".
have_https() {
	curl -fsS --connect-timeout 10 --max-time 20 -o /dev/null \
		"$(cfg https_probe 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip-lite.dat')" 2>/dev/null
	return $?
}

have_tproxy() {
	case "$(firewall_backend)" in
		nft) nft_probe tproxy ;;
		ipt) ipt_probe ;;
		*) return 1 ;;
	esac
	return $?
}

cmd_check() {
	forget_caps
	_missing="$(missing | tr '\n' ' ' | sed 's/ *$//')"

	printf '{"manager":"%s","backend":"%s","missing":[' \
		"$(pkg_manager)" "$(firewall_backend)"
	_first=1
	for _p in $_missing; do
		[ "$_first" = "1" ] || printf ','
		printf '"%s"' "$_p"
		_first=0
	done
	printf '],"can":{'
	printf '"tproxy":%s,' "$(have_tproxy && echo true || echo false)"
	printf '"policy_routing":%s,' "$(have_ip_full && echo true || echo false)"
	printf '"https":%s,' "$(have_https && echo true || echo false)"
	printf '"unzip":%s' "$(command -v unzip >/dev/null 2>&1 && echo true || echo false)"
	printf '}}\n'
	return 0
}

cmd_install() {
	clear_message
	_m="$(pkg_manager)"
	[ "$_m" != "none" ] || {
		say_message "This router has neither opkg nor apk, so nothing can be installed automatically."
		return 1
	}

	_missing="$(missing | tr '\n' ' ' | sed 's/ *$//')"
	if [ -z "$_missing" ]; then
		log "nothing missing"
		return 0
	fi

	log "installing: $_missing"

	# The package index lives in RAM and is empty after every reboot, so this
	# is not optional. It is also the step most likely to fail on a connection
	# that is being interfered with, which is worth saying plainly rather than
	# reporting as "install failed".
	case "$_m" in
		apk)
			if ! bounded 180 apk update >/dev/null 2>&1; then
				say_message "Could not download the package index. The router needs a working internet connection before dependencies can be installed."
				return 1
			fi
			;;
		opkg)
			if ! bounded 180 opkg update >/dev/null 2>&1; then
				say_message "Could not download the package index. The router needs a working internet connection before dependencies can be installed."
				return 1
			fi
			;;
	esac

	# One at a time, so that a name this OpenWrt happens not to have does not
	# take the rest of the list down with it.
	_failed=""
	for _p in $_missing; do
		case "$_m" in
			apk)  bounded 180 apk add "$_p" >/dev/null 2>&1 || _failed="$_failed $_p" ;;
			opkg) bounded 180 opkg install "$_p" >/dev/null 2>&1 || _failed="$_failed $_p" ;;
		esac
	done

	forget_caps

	if [ -n "$_failed" ]; then
		say_message "Installed what it could. These would not install:$_failed - they may have different names on this build of OpenWrt."
		warn "could not install:$_failed"
		return 1
	fi

	log "dependencies installed"
	return 0
}

case "${1:-check}" in
	check)   cmd_check ;;
	install) cmd_install ;;
	*) echo "usage: $0 check|install" >&2; exit 1 ;;
esac
