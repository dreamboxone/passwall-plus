#!/bin/sh /etc/rc.common
#
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of Passwall+ - https://github.com/dreamboxone/passwall-plus

START=95
STOP=10
USE_PROCD=1

PWPLUS_LIB=/usr/libexec
. "$PWPLUS_LIB/pwplus-common.sh"

MKCONFIG="$PWPLUS_LIB/pwplus-mkconfig"
RULES="$PWPLUS_LIB/pwplus-rules"
DNS="$PWPLUS_LIB/pwplus-dns"
BRIDGE="$PWPLUS_LIB/pwplus-bridge"
STATS="$PWPLUS_LIB/pwplus-stats"
STARTED_FLAG="$PWPLUS_RUN/instance-opened"

start_service() {
	rm -f "$STARTED_FLAG"

	if [ "$(cfg_bool enabled 0)" != "1" ]; then
		log "not starting: press Connect first"
		return 0
	fi

	mkdir -p "$PWPLUS_RUN" /var/etc "$PWPLUS_ETC"

	# Choosing a server is seconds of timed requests and must not happen here:
	# procd would be held for the whole measurement, and the service would be
	# neither started nor failed while it waited. pwplus-connect does the
	# choosing and then calls us. At boot there is a choice from last time,
	# which is why it is kept in /etc and not in /var.
	if [ ! -s "$PWPLUS_BEST" ]; then
		log "no server chosen yet - run pwplus-connect, or press Connect"
		return 1
	fi

	if ! "$MKCONFIG" > "$PWPLUS_CONFIG_JSON"; then
		log "could not write $PWPLUS_CONFIG_JSON"
		return 1
	fi
	chmod 600 "$PWPLUS_CONFIG_JSON"

	# Prefer a core the router already has; fall back to our own copy. The
	# candidate has to accept this exact configuration to be chosen, which is
	# a question no version number can answer.
	PROG="$(find_xray "$PWPLUS_CONFIG_JSON")" || PROG=""

	# Refused by every core on the router. When the configuration named a geo
	# category, that is the likeliest reason and it is worth one more try
	# without: geoip.dat and geosite.dat found on a router are not necessarily
	# the pair this expects - another front-end's copy carries different
	# categories, and asking for one it has not got makes the core refuse the
	# whole file. Connected without the split beats not connected, as long as
	# the page says which of the two happened.
	if [ -z "$PROG" ] && grep -q 'geoip:ir\|geosite:ir\|geosite:category-ads-all' "$PWPLUS_CONFIG_JSON" 2>/dev/null; then
		if "$MKCONFIG" nogeo > "$PWPLUS_CONFIG_JSON.nogeo" 2>/dev/null &&
		   PROG="$(find_xray "$PWPLUS_CONFIG_JSON.nogeo")"; then
			mv -f "$PWPLUS_CONFIG_JSON.nogeo" "$PWPLUS_CONFIG_JSON"
			chmod 600 "$PWPLUS_CONFIG_JSON"
			log "the core would not read the routing data - connected with the Iran split off"
			say_message "The routing data on this router is not the pair this expects: the core refused geoip:ir and geosite:ir. Connected with the Iran split off. Press Update beside the routing data on the settings page to fetch the right files."
		else
			rm -f "$PWPLUS_CONFIG_JSON.nogeo"
			PROG=""
		fi
	fi

	if [ -z "$PROG" ]; then
		log "no xray on this router can run the generated configuration"
		return 1
	fi
	log "using $PROG"

	# A server speaking a protocol Xray does not know needs a second program
	# offering it as a local SOCKS port. It has to be running before the
	# tunnel is any use, so it is an instance of this same service and procd
	# keeps it alive on the same terms.
	if "$BRIDGE" needed 2>/dev/null; then
		if BRIDGE_CMD="$("$BRIDGE" command 2>/dev/null)"; then
			log "bridging $(sed -n 's/.*"type"[ \t]*:[ \t]*"\([^"]*\)".*/\1/p' "$PWPLUS_ETC/bridge.json" 2>/dev/null | head -1) through $BRIDGE_CMD"
			procd_open_instance bridge
			# shellcheck disable=SC2086
			procd_set_param command $BRIDGE_CMD
			procd_set_param respawn 3600 5 0
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
		else
			log "the chosen server needs a core this router does not have"
			return 1
		fi
	fi

	procd_open_instance passwall-plus
	procd_set_param command "$PROG" run -config "$PWPLUS_CONFIG_JSON"
	# Where geoip.dat and geosite.dat are. Empty is fine and normal: the
	# configuration only names geo categories when the files are there.
	_geo="$(geo_dir)" || _geo=""
	[ -n "$_geo" ] && procd_set_param env XRAY_LOCATION_ASSET="$_geo"
	# A router's default of 1024 open files is not many when every device on
	# the network has its connections held open by one process.
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 5 0
	# The core's own complaints are the only explanation there is when it will
	# not start, so let them reach the log.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/passwall-plus.pid
	procd_close_instance

	touch "$STARTED_FLAG"
	return 0
}

# Is anything listening on this port? Ask three ways rather than one: a check
# that cannot see a healthy listener is indistinguishable from a tunnel that
# never came up, and it tears the tunnel down either way.
listening() {
	local hex
	hex=$(printf %04X "$1" 2>/dev/null)
	[ -n "$hex" ] || return 1
	grep -qi ":$hex " /proc/net/tcp  2>/dev/null && return 0
	grep -qi ":$hex " /proc/net/tcp6 2>/dev/null && return 0
	grep -qi ":$hex " /proc/net/udp  2>/dev/null && return 0
	netstat -ln 2>/dev/null | grep -q "[:.]$1[[:space:]]" && return 0
	return 1
}

wait_for_port() {
	local port="$1" limit="${2:-20}" n=0
	while [ "$n" -lt "$limit" ]; do
		listening "$port" && return 0
		n=$((n + 1))
		sleep 1
	done
	return 1
}

# Nothing is running yet when start_service returns: procd_open_instance only
# describes the service, and procd is not told to start it until rc.common
# calls procd_close_service afterwards. Waiting for the socket in there was
# waiting for a process nobody had started, so it always timed out and the
# tunnel could never come up. rc.common calls this hook after the service is
# actually running, which is where that wait belongs.
service_started() {
	local tproxy_port bridge_port

	# start_service decided not to start anything. Without this the wait below
	# would run its full course and report a failure about a tunnel nobody
	# asked for.
	[ -f "$STARTED_FLAG" ] || return 0

	tproxy_port="$(cfg tproxy_port 1082)"
	bridge_port="$(cfg bridge_port 10808)"

	if "$BRIDGE" needed 2>/dev/null; then
		if ! wait_for_port "$bridge_port" 15; then
			log "the bridge never started listening on $bridge_port"
			say_status failed
			say_message "The helper for this server's protocol would not start."
			return 1
		fi
	fi

	# The rules send every LAN packet to a port the core listens on, and name
	# lookups to another. Install them before it is listening and the whole
	# network has nowhere to go - no web, no DNS, and no obvious reason why.
	if ! wait_for_port "$tproxy_port" 20; then
		log "xray never started listening on $tproxy_port - leaving the network untouched"
		log "listening now: $(netstat -ln 2>/dev/null | awk '/LISTEN|udp/ { print $4 }' | tr '\n' ' ')"
		say_status failed
		say_message "The tunnel process started but never accepted connections. Check the system log for what it said."
		"$RULES" down >/dev/null 2>&1 || true
		return 1
	fi

	if ! "$RULES" up >/dev/null 2>&1; then
		log "could not install the routing rules - leaving the network untouched"
		say_status failed
		"$RULES" down >/dev/null 2>&1 || true
		return 1
	fi

	"$DNS" up >/dev/null 2>&1 || true

	# Take a first reading now, so the first real sample measures the traffic
	# since the tunnel came up rather than counting the core's start-up twice.
	"$STATS" sample >/dev/null 2>&1 || true

	say_status ready
	log "tunnel up"
	return 0
}

stop_service() {
	# Before anything is killed: the counters live inside the core and vanish
	# with it, so whatever has gone through since the last sample has to be
	# collected while it is still there to collect.
	"$STATS" sample >/dev/null 2>&1 || true
	"$STATS" flush >/dev/null 2>&1 || true

	"$DNS" down >/dev/null 2>&1 || true
	"$RULES" down >/dev/null 2>&1 || true
	rm -f "$PWPLUS_CONFIG_JSON" "$STARTED_FLAG"
	return 0
}

service_stopped() {
	say_status idle
	return 0
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "passwall-plus"
}
