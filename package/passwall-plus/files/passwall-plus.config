#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of Passwall+ - https://github.com/dreamboxone/passwall-plus
#
config passwall-plus 'config'
	# The main switch, as PassWall2 has it. Off until it is turned on in the
	# Main tab of Basic Settings. It holds across a reboot: on comes back on, off
	# stays off.
	option enabled '0'

	# The language of this program's pages: en or fa. It changes nothing
	# else on the router - the rest of LuCI keeps whatever language it was
	# already in.
	option lang 'en'

	# ------------------------------------------------------------ routing

	# Send Iranian sites and addresses straight out instead of through the
	# tunnel. Needs geoip.dat and geosite.dat on the router - the Update
	# buttons beside the two addresses below fetch them. Until they are
	# there this setting does nothing, because a core asked for a geo file
	# it has not got refuses to start at all rather than carrying on
	# without it.
	option route_ir '0'

	# Where that data comes from. Both are editable.
	#
	# These full files are about seventeen and eight megabytes. On a router
	# without room for them, the same project publishes geoip-lite.dat
	# (38 KB) and geosite-lite.dat (2 MB), which carry the ir and private
	# categories this uses and nothing else - put those addresses here
	# instead. The download is refused rather than half-written when there
	# is not enough room either way.
	option geoip_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip.dat'
	option geosite_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geosite.dat'
	option geo_dir '/etc/passwall-plus/geo'
	# Rule Manage's automatic update, as PassWall2 has it: geo_update_week_mode
	# empty for off, 8 for every geo_update_interval_mode hours, 7 for every
	# day, 0-6 for one day of the week, at geo_update_time_mode. geoip_update
	# and geosite_update say which files, for it and for the manual update.
	option geo_update_week_mode ''
	option geo_update_time_mode '0:00'
	option geo_update_interval_mode '2'
	option geoip_update '1'
	option geosite_update '1'

	# Block advertising and tracking domains. Needs the geo data as above.
	option block_ads '0'

	# BitTorrent through a free server is how a free server stops existing.
	option block_torrent '1'

	# ------------------------------------------------------------ the network

	# Where the transparent proxy listens. Change only if something else on
	# the router already uses these.
	option tproxy_port '1082'
	option dns_port '1053'
	option api_port '10853'
	option bridge_port '10808'
	# TCP's own port when Other Settings says REDIRECT rather than TPROXY.
	option redir_port '1085'

	# auto, nftables or iptables. Auto is right unless this router has both
	# and the wrong one is being chosen.
	option firewall_backend 'auto'

	# Leave empty to tunnel every LAN device. Set to one or more interface
	# names (for example 'br-lan') to limit it to those.
	option lan_zone ''

	# How name lookups are handled while connected.
	#
	#   dnsmasq  the router's own resolver keeps answering, and only its
	#            upstream is moved into the tunnel. Local machine names and
	#            DHCP names keep working. This is what you want.
	#   direct   send every query straight into the tunnel. Outside names
	#            resolve; names on your own network stop resolving.
	#   off      change nothing. For a router with its own DNS arrangement.
	option dns_mode 'dnsmasq'

	# Catch clients that ignore the router and ask 8.8.8.8 directly. Without
	# this, a phone with a hardcoded resolver gets answers from outside the
	# tunnel and then connects to whatever it was told.
	option dns_hijack '1'

	# ------------------------------------------------------------ the DNS tab
	#
	# PassWall2's DNS tab, with its option names.
	#
	# Direct DNS answers for everything that goes straight out - the Iranian
	# names when the split is on, the direct domains on the Traffic Rules
	# page - and for the names of the nodes themselves, which can never be
	# looked up through the tunnel they are the way into. Protocol empty is
	# Auto: dnsmasq's own upstream, and failing that whatever the ISP handed
	# out. udp or tcp uses direct_dns, an address with an optional port.
	option direct_dns_protocol ''
	option direct_dns ''
	# Versions before 1.1.0 had one setting for this, the Iranian resolver
	# used for the split. It is still read when direct_dns is empty, and the
	# upgrade moves it across:
	#	option ir_dns ''
	option direct_dns_query_strategy 'UseIPv4'

	# Remote DNS answers for everything else. tcp, udp or doh; TCP is the
	# default because a great many free nodes carry no UDP at all.
	option remote_dns_protocol 'tcp'
	option remote_dns '1.1.1.1'
	option remote_dns_doh 'https://1.1.1.1/dns-query'
	# remote through the tunnel, or direct.
	option remote_dns_detour 'remote'
	option remote_dns_query_strategy 'UseIPv4'
	# EDNS Client Subnet, when a public address is to be told to the resolver.
	option remote_dns_client_ip ''
	# FakeDNS. Only takes effect with dns_mode 'direct', where the router's
	# own lookups do not go to the same resolver.
	option remote_fakedns '0'
	# Domain Override: one "name address" pair per line.
	option dns_hosts ''

	# What to do about IPv6 while the tunnel is up. Almost no server on a
	# free list carries IPv6, and a client that prefers it would leave
	# without the tunnel and look perfectly fine doing it. 'block' refuses
	# it so the client falls back to IPv4, which is tunnelled. Use 'off'
	# only on a connection that is IPv6 only.
	option ipv6 'block'

	# Refuse QUIC (UDP 443) so browsers fall back to TCP. Worth turning on
	# when the chosen server carries UDP badly; off by default, because
	# where UDP does work QUIC is the faster path.
	option block_quic '0'

	# ------------------------------------------------------ traffic rules

	# Sites that answer with a private address and are refused for it by
	# dnsmasq's rebind protection - Iranian banks and government services
	# among them, which resolve to 10.x addresses inside the country. Each
	# one here is added to dhcp.@dnsmasq[0].rebind_domain, and taken out of
	# it again when it is removed here. Entries that were already there
	# before this program are never touched.
	list rebind_domain 'banksepah.ir'
	list rebind_domain 'cbi.ir'
	list rebind_domain 'ebanksepah.ir'
	list rebind_domain 'esata.ir'
	list rebind_domain 'gov.ir'
	list rebind_domain 'medu.ir'
	list rebind_domain 'qmb.ir'
	list rebind_domain 'tamin.ir'
	list rebind_domain 'meedc.net'
	list rebind_domain 'ntp.faraborddi.com'
	# Set once the list above has been put here, so that an upgrade adds it
	# to an older configuration once and never puts back an entry the
	# reader has since removed.
	option rebind_seeded '1'

	# Addresses and names that always go straight out, never through the
	# tunnel. Addresses are skipped by the firewall, so the tunnel never
	# sees them; names are recognised by the core from the connection
	# itself. Both are lists:
	#
	#	list direct_ip '1.2.3.4'
	#	list direct_ip '5.6.0.0/16'
	#	list direct_domain 'example.com'

	# -------------------------------------------------- access control

	# The same thing as PassWall2's Access Control page: per device or per
	# range, send it through the tunnel, through a particular hand-added
	# node, or not at all. The rules themselves are `config acl_rule`
	# sections, written by the web interface.
	option acl_enable '0'

	# Which servers are allowed into the running.
	#
	#   own   only the ones added by hand. This is the default. The
	#         subscriptions are not even fetched, which on a censored
	#         connection saves a minute of waiting on an address that hangs
	#         rather than refusing.
	#   both  the ones added by hand and every subscription that is switched
	#         on: a server added by hand joins the list, it does not replace it.
	#   subs  only the subscriptions.
	#
	# It decides who may be measured, not who wins. Whichever server answers
	# fastest is the one used, wherever it came from. To insist on one
	# particular server, choose it as the Node on the Basic Settings page.
	option sources 'own'
	# Set once subscriptions have schedules of their own; see pwplus-nodes.
	option subs_scheduled '1'

	# PassWall2's Node List options. auto_detection_time is what every
	# hand-added node is measured with when the page opens: 0 (not at all),
	# icmp or tcping. show_node_info shows each node's address and port.
	option auto_detection_time 'tcping'
	option show_node_info '0'

	# PassWall2's keyword filter on node names, for every subscription that
	# does not set its own: 0 off, 1 drop what is in filter_discard_list,
	# 2 keep only what is in filter_keep_list, 3 drop the discard list unless
	# it is in the keep list, 4 keep the keep list unless it is in the
	# discard list. Both lists are `list` options, one word each.
	option filter_keyword_mode '1'

	# ------------------------------------------ Basic Settings: Shunt Rule
	#
	# PassWall2's Shunt Rule tab. Each rule is a `config shunt_rules` section
	# below, and says in its own `node` where it goes. default_node is the
	# Default row - where whatever no rule claims goes: _proxy (the node the
	# tunnel is using), _direct, _blackhole, or a hand-added node's section.
	# Only the rules whose group is shunt_group count. domainStrategy is AsIs,
	# IPIfNonMatch or IPOnDemand, and empty works it out; domainMatcher is
	# hybrid or linear, and empty is Xray's own default.
	option default_node '_proxy'
	option default_preproxy ''
	option shunt_group ''
	# FakeDNS for the rules: the main switch, then a rule's own `fakedns` for
	# its names, and default_fakedns for everything - which, like the DNS
	# tab's, takes effect only with lookups sent straight into the tunnel.
	option shunt_fakedns '0'
	option default_fakedns '0'
	option domainStrategy ''
	option domainMatcher ''

	# ------------------------------------------------ Basic Settings: Main
	#
	# PassWall2's Main tab, with its option names.

	# The node the tunnel uses. Empty is Auto: whichever answers fastest,
	# measured as described under "choosing" below. A hand-added node's
	# section name here uses that node and measures nothing.
	option node ''

	# The router's own traffic through the tunnel too - its downloads, its
	# clock, its package manager. Off by default: when the tunnel is down, so
	# is the router's own way out.
	option localhost_proxy '0'

	# Every LAN device through the tunnel. Off leaves only the devices named
	# on the Access Control page.
	option client_proxy '1'

	# A SOCKS port on the router that goes out the way the tunnel does.
	option node_socks_port '1070'
	option node_socks_bind_local '1'

	# More SOCKS ports, each through a node of its own: `config socks`
	# sections, switched on together by this.
	option socks_enabled '0'

	# ------------------------------------------------ Other Settings: Delay
	#
	# PassWall2's Delay Settings.

	# The quarter-hourly check that brings the tunnel back when it should be
	# up and is not, and moves to another node when the one in use carries
	# nothing.
	option start_daemon '1'
	# Seconds to wait after a reboot before starting.
	option start_delay '1'
	# Stop, start and restart on a schedule. Week mode: empty is off, 7 every
	# day, 0 to 6 a day of the week (0 is Sunday), and for restart 8 is every
	# few hours. Time is H:MM.
	#	option stop_week_mode '7'
	#	option stop_time_mode '1:00'
	#	option start_week_mode '7'
	#	option start_time_mode '7:00'
	#	option restart_week_mode '8'
	#	option restart_interval_mode '6'

	# ------------------------------------------- Other Settings: Forwarding
	#
	# PassWall2's Forwarding Settings. Ports are written 80,443,1000:2000;
	# 1:65535 is all of them. No-redir ports go straight out whatever else is
	# set; redir ports are the only ones sent into the tunnel.
	option tcp_no_redir_ports ''
	option udp_no_redir_ports ''
	option tcp_redir_ports '1:65535'
	option udp_redir_ports '1:65535'
	# tproxy, or redirect for TCP (UDP is always TPROXY).
	option tcp_proxy_way 'tproxy'
	# Answer pings to tunnelled addresses from the router, since a tunnel
	# carries no ICMP.
	option accept_icmp '0'

	# ----------------------------------------------- Other Settings: Xray
	#
	# Override the connection's destination with the name sniffed from it,
	# except for the names in excluded_domains - one per line. Off uses the
	# name for routing only.
	option sniffing_override_dest '1'
	option excluded_domains 'courier.push.apple.com
dlg.io.mi.com
marscdn.c2c.wechat.com'
	# Buffer per connection, in kB. Empty is Xray's own default.
	option buffer_size ''

	# ------------------------------------------------------------ choosing

	# How the first pass decides a server is worth measuring properly.
	#
	#   tcp   one TCP handshake to the server's real port. This is the
	#         default and the right answer.
	#   icmp  a ping. Cheaper still, and wrong often enough to matter: a
	#         server behind a CDN answers pings at the edge whatever the
	#         state of the server, and plenty of working servers drop ICMP
	#         entirely. Here because it was asked for.
	#   both  ping first, then handshake. Strictest, and drops the most.
	option prefilter 'tcp'
	option sift_timeout '2'
	option sift_parallel '30'

	# The second pass, in batches, best handshake first. It stops at the
	# first server that comes back under good_ms - so connecting usually
	# costs one batch, not the whole list.
	option batch_size '10'
	option good_ms '1000'
	option max_batches '5'
	option test_timeout '6'
	option test_url 'http://www.gstatic.com/generate_204'

	# Ignore a measurement older than this and take a new one.
	option fresh_seconds '3600'

	# A ceiling on one round of candidates.
	option max_nodes '300'

	# ------------------------------------------------------------ traffic

	# How often the running totals reach flash, in minutes. Every five
	# minutes they are added up in RAM; this is how often that sum is
	# written down, and therefore how much can be lost if the router loses
	# power. Five matches how often the counters are read, so at most one
	# sample is ever at risk.
	option stats_flush_minutes '5'

	# ------------------------------------------------------------ the cores

	# Where downloaded cores are kept. Point this at a USB stick or a data
	# partition on a router whose flash is too small for sing-box.
	option core_dir '/usr/libexec/passwall-plus'

	# Force a particular Xray. Empty means: use whichever one on this router
	# will accept the generated configuration, preferring one that is already
	# installed - which is how a router that already has xray-core, because
	# PassWall2 pulled it in, ends up with one copy rather than two.
	option core_xray ''
	# PassWall2's App Path for the helpers: the file itself, installed,
	# updated and run there. Empty is this program's own copy in core_dir.
	option core_singbox ''
	option core_hysteria ''
	# Geoview, for the Geo View page, installed from App Update like the cores.
	option core_geoview ''

	# The core's own log, as on PassWall2's Log tab. log_node off is a core
	# that writes nothing. 'warning' is right; 'debug' is a great deal of
	# output and worth it only while chasing something.
	option log_node '1'
	option loglevel 'warning'

	# ------------------------------------------------------------ the Xray tab
	#
	# Applied to every node the tunnel may use, exactly as PassWall2 applies
	# its Xray settings.

	# The pre-proxy: every node dials out through this hand-added node.
	# PassWall2 sets it on a shunt node; here the tunnel is that shunt.
	option preproxy_enabled '0'
	option preproxy_node ''

	# TCP fragment of the TLS hello, which gets past an SNI blacklist more
	# often than not. On the hop that meets the network, not inside a chain.
	option fragment '0'
	option fragment_packets 'tlshello'
	option fragment_lengths '3-5,6-8,10-20'
	option fragment_delays '10-20'
	option fragment_maxSplit '3-6'

	# UDP noise, for mKCP and for xhttp over HTTP/3. The packets themselves
	# are `config xray_noise_packets` sections, as in PassWall2.
	option noise '0'

	# Mux: several connections carried in one. Not for a VLESS flow, xhttp
	# or WireGuard, where it cannot work.
	option mux '0'
	option mux_concurrency '8'
	option xudp_concurrency '16'
	option xudp_proxy_udp443 'reject'

	# What the Dependencies check fetches to prove this router can reach an
	# HTTPS address at all. Only ever downloaded to /dev/null.
	option https_probe 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip-lite.dat'

# Where the nodes come from. Add as many as you like; each one is a
# `config subscription` section, and the web interface writes them here.
#
# A section may carry an address to fetch, or the file itself. `content` holds
# a whole configuration - Xray, sing-box, Clash, a WireGuard .conf, or a plain
# list of links - handed over rather than downloaded, and the Browse button on
# the Node Subscribe page is what fills it in. A section with `content` set is
# never fetched: there is nowhere to fetch it from.
#
# PassWall2's options for one subscription, with its names: user_agent (what
# the request says it is, v2rayN/9.99 unless set), access_mode (empty for
# Auto, direct, or proxy - through the tunnel's own SOCKS port), and
# filter_keyword_mode 5 for the global filter above or 0-4 with its own
# filter_discard_list and filter_keep_list.
#
# When it is read: update_week_mode refresh is every quarter of an hour, with
# the node list's own refresh - the default list below is; empty is only when
# its button is pressed, or once if it has never been read; 8 is every
# update_interval_mode hours; 7 every day and 0-6 one day of the week, at
# update_time_mode. boot_update 1 reads it once after every boot as well.
# What it brought is kept on flash too, so a reboot does not lose it.
#
# Its own chain - PassWall2's Chain Proxy - for every node in it:
# chain_proxy 1 dials out through the hand-added node in preproxy_node;
# chain_proxy 2 goes on through each node to the hand-added node in to_node,
# which is where the traffic finally leaves from.
config subscription 'default'
	option name 'Top 100'
	option url 'https://raw.githubusercontent.com/0xRadikal/Free-v2ray-Configs/main/top100.txt'
	option enabled '1'
	option update_week_mode 'refresh'

# A server added by hand looks like this. `link` takes one share link, or
# several separated by newlines.
#
# config node
#	option name 'my own server'
#	option link 'vless://...'
#	option enabled '1'
#	option group 'home'
#
# It may have a chain of its own - PassWall2's Chain Proxy, with its option
# names. chain_proxy 1 dials out through the hand-added node named in
# preproxy_node; chain_proxy 2 goes on from this node to the landing node
# named in to_node, which is where the traffic finally leaves from.
#
#	option chain_proxy '1'
#	option preproxy_node 'cfg0a1b2c'

# An access control rule looks like this. mode is 0 for not through the
# tunnel at all, 1 for through the hand-added node named in `node`, and 2 for
# through whichever node the tunnel is using. The ports are written the way
# PassWall2 writes them: 80,443,1000:2000, and 1:65535 for all of them.
#
# config acl_rule
#	option enabled '1'
#	option remarks 'the television'
#	option interface ''
#	list sources '00:11:22:33:44:55'
#	list sources '192.168.1.50-192.168.1.60'
#	option mode '0'
#	option tcp_redir_ports '1:65535'
#	option udp_redir_ports '1:65535'

# A shunt rule, made on the Traffic Rules page with PassWall2's fields: which
# traffic, by name, address, protocol, port, source and way in - and `node`,
# set in the Shunt Rule tab of Basic Settings, for where it goes: empty for not
# used, _default for the Default row, _proxy, _direct, _blackhole, or a
# hand-added node's section. domain_list and ip_list take one entry a line,
# the way Xray writes them; # starts a comment.
#
# config shunt_rules
#	option remarks 'Telegram'
#	option group ''
#	option network 'tcp,udp'
#	option domain_list 'domain:telegram.org
#domain:t.me'
#	option ip_list '91.108.4.0/22
#149.154.160.0/20'
#	option node '_proxy'
#
# A rule going to a hand-added node may reach it through another - PassWall2's
# per-rule Preproxy - and may have its names answered by FakeDNS:
#
#	option preproxy 'cfg0a1b2c'
#	option fakedns '1'

# A noise packet, for the Xray tab's Noise switch. type is rand (packet is a
# length or a range), str, hex, base64 or array; delay is milliseconds.
#
# config xray_noise_packets
#	option enabled '1'
#	option type 'rand'
#	option packet '10-20'
#	option delay '10-16'

# A SOCKS port of its own, through one node - PassWall2's Socks Config. node
# empty is whichever node the tunnel is using; a hand-added node's section
# name is that node. Switched on together by socks_enabled.
#
# config socks
#	option enabled '1'
#	option node ''
#	option port '1081'
