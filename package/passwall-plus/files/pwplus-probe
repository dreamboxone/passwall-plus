#
# pwplus-probe - choose a server without making the router earn it.
#
#   pwplus-probe select      the whole thing: sift, then measure, then pick
#   pwplus-probe sift        reachability only
#
# The old way was to stand up one Xray holding a hundred inbounds and a
# hundred outbounds, then fire a hundred proxied requests at it. It worked,
# and it cost about thirty seconds, a hundred listening sockets and more
# memory than a small router has to spare - every time, even when the very
# first server would have done.
#
# This does it in two passes.
#
# The first knocks on every door: one TCP handshake per server, thirty at a
# time, two seconds each. A server that will not complete a handshake cannot
# carry anything, and finding that out costs three packets. On a typical
# hundred-server list this removes half to two thirds of them in a few
# seconds, and it hands back the handshake time, which is a genuine measure
# of how far away the server is.
#
# The second takes what survived, best handshake first, and measures ten at a
# time properly - a real proxied HTTP request, timed end to end, which is the
# only thing that proves a route actually works. If anything in the batch
# comes back under the threshold, that is the answer and the remaining
# batches never run. Because the batches are ordered by handshake time, the
# server that is going to win is usually in the first one.
#
# So the common case is one small Xray with ten inbounds for a few seconds,
# instead of one large Xray with a hundred for thirty.
#
# On ICMP, which is the obvious way to do the first pass and the wrong one: a
# great many of these servers sit behind Cloudflare, where a ping is answered
# by the edge and says nothing whatever about the server behind it, and a
# great many others simply drop ICMP while serving TCP perfectly. Gating on
# ping therefore throws away working servers and keeps unusable ones. The TCP
# handshake asks the same question - are you there, and how far - of the
# exact port the tunnel will use, and it costs the same. ICMP is still here,
# under `prefilter`, for anyone who wants it.

set -e

. "${PWPLUS_LIB:-/usr/libexec}/pwplus-common.sh"

BASE_PORT=24000
TEST_CFG="$PWPLUS_RUN/test.json"
ALIVE="$PWPLUS_RUN/alive.tsv"
RESULTS="$PWPLUS_RUN/results.tsv"
ATTEMPTS="$PWPLUS_RUN/attempts"
# Servers no core on this router can use. Kept for the life of a boot, so
# the same dud is never checked twice, and forgotten across one, so a core
# upgrade gets to change the answer.
REJECTED="$PWPLUS_RUN/rejected"

# What a test request is measured against: small, fast, unauthenticated, and
# a 204 with no body when the whole path worked.
TEST_URL="$(cfg test_url 'http://www.gstatic.com/generate_204')"
SIFT_TIMEOUT="$(cfg sift_timeout 2)"
SIFT_PARALLEL="$(cfg sift_parallel 30)"
TEST_TIMEOUT="$(cfg test_timeout 6)"
BATCH="$(cfg batch_size 10)"
GOOD_MS="$(cfg good_ms 1000)"
MAX_BATCHES="$(cfg max_batches 5)"
PREFILTER="$(cfg prefilter tcp)"

progress() {
	printf 'phase=%s\ntotal=%s\ndone=%s\nalive=%s\ntested=%s\nbest_ms=%s\n' \
		"$1" "$2" "$3" "$4" "$5" "$6" > "$PWPLUS_PROGRESS" 2>/dev/null || true
	return 0
}

count() { wc -l < "$1" 2>/dev/null | tr -d ' \t' || echo 0; }

# ------------------------------------------------------------------ pass 1

# One handshake, timed. curl reports time_connect as zero when it never got
# there, which is exactly the signal we want and needs no exit code table:
# whatever the server does with the nonsense HTTP request that follows -
# answer it, close, sit there until the timeout - the handshake either
# completed or it did not.
tcp_ms() {
	_h="$1"
	# a bare IPv6 literal needs brackets before it can go in a URL
	case "$_h" in *:*) _h="[$_h]" ;; esac
	_t="$(curl -s -o /dev/null \
		--connect-timeout "$SIFT_TIMEOUT" --max-time "$SIFT_TIMEOUT" \
		-w '%{time_connect}' "http://$_h:$2/" 2>/dev/null)" || _t=""
	[ -n "$_t" ] || { echo 0; return 0; }
	# Zero means it never got there. A server that is genuinely under half a
	# millisecond away would otherwise round to zero and be called dead, so
	# anything that did connect reports at least one.
	awk -v t="$_t" 'BEGIN { m = int(t * 1000 + 0.5); if (t > 0 && m < 1) m = 1; printf "%d", m }'
	return 0
}

icmp_ms() {
	if ! _o="$(ping -c 1 -W "$SIFT_TIMEOUT" -q "$1" 2>/dev/null)"; then
		echo 0
		return 0
	fi
	_v="$(printf '%s' "$_o" | awk -F'[ /]+' '
		/round-trip|min\/avg/ {
			for (i = 1; i <= NF; i++)
				if ($i ~ /^[0-9]+\.?[0-9]*$/) { printf "%d", $i + 0.5; exit }
		}')"
	[ -n "$_v" ] && [ "$_v" -gt 0 ] 2>/dev/null || _v=1
	echo "$_v"
	return 0
}

sift_one() {
	_tag="$1"; _host="$2"; _port="$3"; _proto="${4:-}"
	_ms=0

	# A handshake asks a question these protocols cannot answer. WireGuard,
	# hysteria2 and tuic live on UDP and nothing is listening on the TCP port
	# at all, so the first pass was quietly discarding every one of them - the
	# program has carried hysteria2 and tuic since it was written and would
	# never once have measured one. They go through with a distance that puts
	# them behind everything that did answer, and the second pass, which makes
	# a real request, decides whether they work.
	case "$_proto" in
		wireguard|hysteria2|hysteria|tuic)
			printf '%06d\t%s\n' 9000 "$_tag" >> "$ALIVE"
			echo x >> "$ATTEMPTS"
			return 0
			;;
	esac

	case "$PREFILTER" in
		icmp)
			_ms="$(icmp_ms "$_host")"
			;;
		both)
			_p="$(icmp_ms "$_host")"
			if [ "${_p:-0}" -gt 0 ] 2>/dev/null; then
				_ms="$(tcp_ms "$_host" "$_port")"
			fi
			;;
		*)
			_ms="$(tcp_ms "$_host" "$_port")"
			;;
	esac
	[ -n "$_ms" ] || _ms=0
	if [ "$_ms" -gt 0 ] 2>/dev/null; then
		printf '%06d\t%s\n' "$_ms" "$_tag" >> "$ALIVE"
	fi
	echo x >> "$ATTEMPTS"
	return 0
}

cmd_sift() {
	[ -s "$PWPLUS_CANDIDATES" ] || { warn "no candidates to sift"; return 1; }
	: > "$ALIVE"
	: > "$ATTEMPTS"
	_total="$(count "$PWPLUS_CANDIDATES")"
	progress prefilter "$_total" 0 0 0 0

	_running=0
	_pids=""
	while IFS="	" read -r tag label proto host port payload; do
		[ -n "$tag" ] || continue
		sift_one "$tag" "$host" "$port" "$proto" &
		_pids="$_pids $!"
		_running=$((_running + 1))
		if [ "$_running" -ge "$SIFT_PARALLEL" ]; then
			# Always by pid, never a bare `wait`: a bare wait also waits on
			# every other background job this shell owns, and one of those is
			# a core that is never going to exit.
			for _p in $_pids; do wait "$_p" 2>/dev/null || true; done
			_pids=""
			_running=0
			progress prefilter "$_total" "$(count "$ATTEMPTS")" "$(count "$ALIVE")" 0 0
		fi
	done < "$PWPLUS_CANDIDATES"
	for _p in $_pids; do wait "$_p" 2>/dev/null || true; done

	sort -n "$ALIVE" -o "$ALIVE" 2>/dev/null || true
	_alive="$(count "$ALIVE")"
	progress prefilter "$_total" "$_total" "$_alive" 0 0
	log "reachable: $_alive of $_total servers answered a handshake"

	if [ "$_alive" -eq 0 ]; then
		say_message "No server on the list answered at all. The connection itself may be blocking them, or the list may be stale."
		return 1
	fi
	return 0
}

# ------------------------------------------------------------------ pass 2

# Everything the batch needs, in one small Xray: one SOCKS inbound per server,
# that server's outbound behind it, and a routing rule joining the two.
build_batch_config() {
	_list="$1"
	{
		printf '{"log":{"loglevel":"none"},"inbounds":['
		_i=0
		while IFS="	" read -r tag label proto host port payload; do
			[ -n "$tag" ] || continue
			[ "$_i" -gt 0 ] && printf ','
			printf '{"tag":"in_%s","listen":"127.0.0.1","port":%d,"protocol":"socks","settings":{"udp":false}}' \
				"$tag" $((BASE_PORT + _i))
			_i=$((_i + 1))
		done < "$_list"
		printf '],"outbounds":['
		_i=0
		while IFS="	" read -r tag label proto host port payload; do
			[ -n "$tag" ] || continue
			[ "$_i" -gt 0 ] && printf ','
			printf '%s' "$payload" | sed "s/^{/{\"tag\":\"$tag\",/"
			_i=$((_i + 1))
		done < "$_list"
		printf '],"routing":{"rules":['
		_i=0
		while IFS="	" read -r tag label proto host port payload; do
			[ -n "$tag" ] || continue
			[ "$_i" -gt 0 ] && printf ','
			printf '{"type":"field","inboundTag":["in_%s"],"outboundTag":"%s"}' "$tag" "$tag"
			_i=$((_i + 1))
		done < "$_list"
		printf ']}}'
	} > "$TEST_CFG"
	return 0
}

kill_stale_tester() {
	# A tester left behind by an interrupted run still holds every one of
	# these ports. The next run then cannot bind, every measurement fails,
	# and the answer is "no server responded" for good - a failure that keeps
	# itself alive and looks exactly like the network.
	_stale="$(pgrep -f "run -config $TEST_CFG" 2>/dev/null || true)"
	[ -n "$_stale" ] && kill $_stale 2>/dev/null || true
	return 0
}

# Throw out the entries the core will not accept, and keep the rest.
#
# A batch is validated as one configuration, so a single unusable server -
# a REALITY key that is not a key, a cipher Xray dropped years ago, and free
# lists carry both - makes the core refuse the entire batch. Nine working
# servers then measure as nothing at all, and with the batches ordered by
# handshake time the nine thrown away are the nine most likely to have won.
#
# So when a batch is refused, each of its members is offered on its own and
# the bad ones are written down. Ten extra checks, only ever on a batch that
# was already going to be lost, and never again for the same server.
prune_batch() {
	_list="$1"
	_kept="$_list.kept"
	: > "$_kept"
	while IFS="	" read -r tag label proto host port payload; do
		[ -n "$tag" ] || continue
		printf '{"log":{"loglevel":"none"},"outbounds":[%s]}' \
			"$(printf '%s' "$payload" | sed 's/^{/{"tag":"one",/')" > "$PWPLUS_RUN/one.json"
		if find_xray "$PWPLUS_RUN/one.json" >/dev/null 2>&1; then
			printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$tag" "$label" "$proto" "$host" "$port" "$payload" >> "$_kept"
		else
			echo "$tag" >> "$REJECTED"
			log "dropping $host:$port - no core on this router can use it"
		fi
	done < "$_list"
	rm -f "$PWPLUS_RUN/one.json"
	mv -f "$_kept" "$_list"
	return 0
}

# Measure one batch. Appends "ms<TAB>tag" per server that answered.
run_batch() {
	_list="$1"
	build_batch_config "$_list"

	if ! _xray="$(find_xray "$TEST_CFG")"; then
		prune_batch "$_list"
		if [ ! -s "$_list" ]; then
			warn "no server in this batch can be used by any core on this router"
			return 1
		fi
		build_batch_config "$_list"
		if ! _xray="$(find_xray "$TEST_CFG")"; then
			warn "this batch is still refused after dropping the bad entries"
			return 1
		fi
	fi

	"$_xray" run -config "$TEST_CFG" >/dev/null 2>&1 &
	_xpid=$!
	trap 'kill "$_xpid" 2>/dev/null || true' INT TERM
	# Without this the first server in every batch is scored on the core's
	# start-up rather than on its own latency.
	sleep 1

	if ! kill -0 "$_xpid" 2>/dev/null; then
		warn "the batch tester did not start - ports busy, or a bad entry"
		return 1
	fi

	_i=0
	_pids=""
	while IFS="	" read -r tag label proto host port payload; do
		[ -n "$tag" ] || continue
		_port=$((BASE_PORT + _i))
		_i=$((_i + 1))
		(
			# curl exits zero only when the whole request completed, so a
			# non-zero exit is exactly the "this route does not work" signal.
			if _ms="$(curl -s -o /dev/null \
				-x "socks5h://127.0.0.1:$_port" \
				--connect-timeout "$TEST_TIMEOUT" --max-time "$TEST_TIMEOUT" \
				-w '%{time_total}' "$TEST_URL" 2>/dev/null)"
			then
				printf '%06d\t%s\n' \
					"$(awk -v t="$_ms" 'BEGIN { printf "%d", t * 1000 }')" \
					"$tag" >> "$RESULTS"
			fi
			echo x >> "$ATTEMPTS"
		) &
		_pids="$_pids $!"
	done < "$_list"
	for _p in $_pids; do wait "$_p" 2>/dev/null || true; done

	# A measurement is only worth its result if the thing doing the measuring
	# lasted through it.
	if ! kill -0 "$_xpid" 2>/dev/null; then
		warn "the batch tester did not survive its own batch - these results mean little"
	fi
	kill "$_xpid" 2>/dev/null || true
	wait "$_xpid" 2>/dev/null || true
	trap - INT TERM
	rm -f "$TEST_CFG"
	return 0
}

# ------------------------------------------------------------------ select

cmd_select() {
	[ -s "$PWPLUS_CANDIDATES" ] || { warn "no candidates"; return 1; }
	kill_stale_tester

	cmd_sift || return 1

	: > "$RESULTS"
	_total="$(count "$PWPLUS_CANDIDATES")"
	_alive="$(count "$ALIVE")"
	_tested=0
	_batch_no=0
	_best_ms=0

	# Best handshake first, so the server that is going to win is usually in
	# the first batch and the rest never have to run. Anything a core has
	# already refused is left out rather than being offered again.
	touch "$REJECTED"
	if [ -s "$REJECTED" ]; then
		cut -f2 "$ALIVE" | grep -vxF -f "$REJECTED" > "$PWPLUS_RUN/order.txt" || true
	else
		cut -f2 "$ALIVE" > "$PWPLUS_RUN/order.txt"
	fi

	while [ "$_batch_no" -lt "$MAX_BATCHES" ]; do
		_from=$((_batch_no * BATCH + 1))
		_to=$(((_batch_no + 1) * BATCH))
		sed -n "${_from},${_to}p" "$PWPLUS_RUN/order.txt" > "$PWPLUS_RUN/batch.tags"
		[ -s "$PWPLUS_RUN/batch.tags" ] || break

		# The candidate rows for exactly these tags, in handshake order.
		: > "$PWPLUS_RUN/batch.tsv"
		while read -r t; do
			[ -n "$t" ] || continue
			awk -F'\t' -v t="$t" '$1 == t { print; exit }' "$PWPLUS_CANDIDATES" >> "$PWPLUS_RUN/batch.tsv"
		done < "$PWPLUS_RUN/batch.tags"
		[ -s "$PWPLUS_RUN/batch.tsv" ] || break

		_batch_no=$((_batch_no + 1))
		_n="$(count "$PWPLUS_RUN/batch.tsv")"
		_tested=$((_tested + _n))
		progress urltest "$_total" "$_total" "$_alive" "$_tested" "$_best_ms"
		log "batch $_batch_no: measuring $_n servers"

		run_batch "$PWPLUS_RUN/batch.tsv" || true

		if [ -s "$RESULTS" ]; then
			_best_ms="$(sort -n "$RESULTS" | head -1 | cut -f1 | sed 's/^0*//')"
			[ -n "$_best_ms" ] || _best_ms=0
			progress urltest "$_total" "$_total" "$_alive" "$_tested" "$_best_ms"
			# Good enough is the point. Carrying on to measure fifty more
			# servers in the hope of shaving eighty milliseconds off a
			# connection that is already fine is exactly the cost this was
			# written to avoid.
			if [ "$_best_ms" -gt 0 ] && [ "$_best_ms" -le "$GOOD_MS" ]; then
				log "found a server under ${GOOD_MS}ms in batch $_batch_no - stopping here"
				break
			fi
		fi
	done

	rm -f "$PWPLUS_RUN/batch.tags" "$PWPLUS_RUN/batch.tsv" "$PWPLUS_RUN/order.txt"

	if [ ! -s "$RESULTS" ]; then
		progress done "$_total" "$_total" "$_alive" "$_tested" 0
		say_message "$_alive of $_total servers answered a handshake, but none of them could complete a request."
		warn "no server completed a test request"
		return 1
	fi

	# Everything that answered, fastest first, so healing can take the next
	# one down the list without measuring the whole thing again.
	: > "$PWPLUS_RANKED"
	sort -n "$RESULTS" | while IFS="	" read -r ms tag; do
		awk -F'\t' -v t="$tag" -v m="$ms" \
			'$1 == t { printf "%d\t%s\t%s\t%s\t%s\t%s\n", m, $1, $2, $3, $4, $5; exit }' \
			"$PWPLUS_CANDIDATES" >> "$PWPLUS_RANKED"
	done

	_best="$(sort -n "$RESULTS" | head -1)"
	_bms="$(printf '%s' "${_best%%	*}" | sed 's/^0*//')"
	[ -n "$_bms" ] || _bms=0
	_btag="${_best#*	}"

	select_tag "$_btag" "$_bms" || return 1

	progress done "$_total" "$_total" "$_alive" "$_tested" "$_bms"
	log "selected $(sed -n 's/^label=//p' "$PWPLUS_BEST_META" | head -1) at ${_bms}ms ($(count "$RESULTS") of $_tested measured servers answered)"
	return 0
}

# Write down the choice. Everything downstream reads these two files and
# nothing else, so a hand-picked node and a measured one are the same thing
# from here on.
select_tag() {
	_tag="$1"
	_ms="${2:-0}"

	_row="$(awk -F'\t' -v t="$_tag" '$1 == t { print; exit }' "$PWPLUS_CANDIDATES")"
	[ -n "$_row" ] || { warn "chosen server is not in the list any more"; return 1; }

	_label="$(printf '%s' "$_row" | cut -f2)"
	_proto="$(printf '%s' "$_row" | cut -f3)"
	_host="$(printf '%s' "$_row" | cut -f4)"
	_port="$(printf '%s' "$_row" | cut -f5)"
	_payload="$(printf '%s' "$_row" | cut -f6-)"

	_tmp="$PWPLUS_RUN/best.new"
	case "$_proto" in
		hysteria2|tuic)
			# Xray cannot speak these. pwplus-bridge runs a core that can and
			# offers it as a plain SOCKS port on loopback, so what Xray ends
			# up holding is an ordinary socks outbound and nothing else in the
			# program has to know the difference.
			_bport="$(cfg bridge_port 10808)"
			printf '%s\n' "$_payload" > "$PWPLUS_RUN/bridge.new"
			write_if_changed "$PWPLUS_RUN/bridge.new" "$PWPLUS_ETC/bridge.json" || true
			rm -f "$PWPLUS_RUN/bridge.new"
			printf '{"protocol":"socks","settings":{"servers":[{"address":"127.0.0.1","port":%s}]},"streamSettings":{"network":"tcp"}}\n' \
				"$_bport" > "$_tmp"
			;;
		*)
			rm -f "$PWPLUS_ETC/bridge.json"
			printf '%s\n' "$_payload" > "$_tmp"
			;;
	esac

	write_if_changed "$_tmp" "$PWPLUS_BEST" || true
	rm -f "$_tmp"

	printf 'tag=%s\nlabel=%s\nprotocol=%s\nhost=%s\nport=%s\nlatency_ms=%s\ntested=%s\ntotal=%s\nalive=%s\n' \
		"$_tag" "$_label" "$_proto" "$_host" "$_port" "$_ms" "$(date -u +%s)" \
		"$(count "$PWPLUS_CANDIDATES")" "$(count "$ALIVE")" > "$PWPLUS_RUN/meta.new"
	write_if_changed "$PWPLUS_RUN/meta.new" "$PWPLUS_BEST_META" || true
	rm -f "$PWPLUS_RUN/meta.new"
	return 0
}

# Take the next server down the ranked list. This is what healing does when
# the server we picked has stopped working: the measurement is minutes old
# and still good, so re-running it would cost half a minute to learn what is
# already written down.
cmd_next() {
	[ -s "$PWPLUS_RANKED" ] || return 1
	_cur="$(sed -n 's/^tag=//p' "$PWPLUS_BEST_META" 2>/dev/null | head -1)"
	_take=""
	_found=0
	while IFS="	" read -r ms tag label proto host port; do
		[ -n "$tag" ] || continue
		if [ "$_found" = "1" ]; then _take="$tag"; break; fi
		[ "$tag" = "$_cur" ] && _found=1
	done < "$PWPLUS_RANKED"
	[ -n "$_take" ] || return 1
	_ms="$(awk -F'\t' -v t="$_take" '$2 == t { print $1; exit }' "$PWPLUS_RANKED")"
	log "moving to the next measured server down the list"
	select_tag "$_take" "${_ms:-0}"
	return $?
}

case "${1:-select}" in
	select) cmd_select ;;
	sift)   cmd_sift ;;
	next)   cmd_next ;;
	pick)   [ -n "${2:-}" ] || { echo "usage: $0 pick <tag>" >&2; exit 1; }
	        select_tag "$2" 0 ;;
	# Rewrites a candidate file in place, keeping only what a core here can
	# actually run. Useful on its own, and the only way to check the pruning
	# without a network to check it over.
	prune)  [ -n "${2:-}" ] || { echo "usage: $0 prune <file>" >&2; exit 1; }
	        touch "$REJECTED"; prune_batch "$2" ;;
	*) echo "usage: $0 select|sift|next|pick <tag>|prune <file>" >&2; exit 1 ;;
esac
