config ovpn 'config'
	# Nothing runs until Connect is pressed. Set by the web interface.
	option enabled '0'

	# Reconnect automatically after the router reboots.
	option autostart '0'

	# ------------------------------------------------------------ routing

	# Send Iranian sites and addresses straight out instead of through the
	# tunnel. Needs geoip.dat and geosite.dat on the router - the Update
	# buttons beside the two addresses below fetch them. Until they are
	# there this setting does nothing, because a core asked for a geo file
	# it has not got refuses to start at all rather than carrying on
	# without it.
	option route_ir '0'

	# Where that data comes from. Both are editable.
	#
	# These full files are about seventeen and eight megabytes. On a router
	# without room for them, the same project publishes geoip-lite.dat
	# (38 KB) and geosite-lite.dat (2 MB), which carry the ir and private
	# categories this uses and nothing else - put those addresses here
	# instead. The download is refused rather than half-written when there
	# is not enough room either way.
	option geoip_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip.dat'
	option geosite_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geosite.dat'
	option geo_dir '/etc/ovpn/geo'

	# Block advertising and tracking domains. Needs the geo data as above.
	option block_ads '0'

	# BitTorrent through a free server is how a free server stops existing.
	option block_torrent '1'

	# ------------------------------------------------------------ the network

	# Where the transparent proxy listens. Change only if something else on
	# the router already uses these.
	option tproxy_port '1082'
	option dns_port '1053'
	option api_port '10853'
	option bridge_port '10808'

	# auto, nftables or iptables. Auto is right unless this router has both
	# and the wrong one is being chosen.
	option firewall_backend 'auto'

	# Leave empty to tunnel every LAN device. Set to one or more interface
	# names (for example 'br-lan') to limit it to those.
	option lan_zone ''

	# How name lookups are handled while connected.
	#
	#   dnsmasq  the router's own resolver keeps answering, and only its
	#            upstream is moved into the tunnel. Local machine names and
	#            DHCP names keep working. This is what you want.
	#   direct   send every query straight into the tunnel. Outside names
	#            resolve; names on your own network stop resolving.
	#   off      change nothing. For a router with its own DNS arrangement.
	option dns_mode 'dnsmasq'

	# Catch clients that ignore the router and ask 8.8.8.8 directly. Without
	# this, a phone with a hardcoded resolver gets answers from outside the
	# tunnel and then connects to whatever it was told.
	option dns_hijack '1'

	# The resolver used for Iranian names when the split is on. It has to be
	# inside Iran, or an Iranian CDN answers with a foreign edge and "direct"
	# then takes the long way round.
	#
	# Empty means none, and none is the default: an Iranian resolver sees
	# every name this router looks up, which is a thing to choose rather than
	# a thing to be given. The split works without one. The web interface
	# offers the usual public ones in a list.
	option ir_dns ''
	option remote_dns '1.1.1.1'

	# What to do about IPv6 while the tunnel is up. Almost no server on a
	# free list carries IPv6, and a client that prefers it would leave
	# without the tunnel and look perfectly fine doing it. 'block' refuses
	# it so the client falls back to IPv4, which is tunnelled. Use 'off'
	# only on a connection that is IPv6 only.
	option ipv6 'block'

	# Refuse QUIC (UDP 443) so browsers fall back to TCP. Worth turning on
	# when the chosen server carries UDP badly; off by default, because
	# where UDP does work QUIC is the faster path.
	option block_quic '0'

	# ------------------------------------------------------------ choosing

	# How the first pass decides a server is worth measuring properly.
	#
	#   tcp   one TCP handshake to the server's real port. This is the
	#         default and the right answer.
	#   icmp  a ping. Cheaper still, and wrong often enough to matter: a
	#         server behind a CDN answers pings at the edge whatever the
	#         state of the server, and plenty of working servers drop ICMP
	#         entirely. Here because it was asked for.
	#   both  ping first, then handshake. Strictest, and drops the most.
	option prefilter 'tcp'
	option sift_timeout '2'
	option sift_parallel '30'

	# The second pass, in batches, best handshake first. It stops at the
	# first server that comes back under good_ms - so connecting usually
	# costs one batch, not the whole list.
	option batch_size '10'
	option good_ms '1000'
	option max_batches '5'
	option test_timeout '6'
	option test_url 'http://www.gstatic.com/generate_204'

	# Ignore a measurement older than this and take a new one.
	option fresh_seconds '3600'

	# A ceiling on one round of candidates.
	option max_nodes '300'

	# ------------------------------------------------------------ traffic

	# How often the running totals reach flash. Every five minutes they are
	# added up in RAM; this is how often that sum is written down. Lower
	# means less lost to a power cut and more wear on the flash.
	option stats_flush_seconds '3600'

	# ------------------------------------------------------------ the cores

	# Where downloaded cores are kept. Point this at a USB stick or a data
	# partition on a router whose flash is too small for sing-box.
	option core_dir '/usr/libexec/ovpn'

	# Force a particular Xray. Empty means: use whichever one on this router
	# will accept the generated configuration, preferring one that is already
	# installed - which is how a router that already has xray-core, because
	# PassWall2 pulled it in, ends up with one copy rather than two.
	option core_xray ''

	# What the core writes to the system log. 'warning' is right; 'debug' is
	# a great deal of output and worth it only while chasing something.
	option loglevel 'warning'

	# What the Dependencies check fetches to prove this router can reach an
	# HTTPS address at all. Only ever downloaded to /dev/null.
	option https_probe 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip-lite.dat'

# Where the servers come from. Add as many as you like; each one is a
# `config subscription` section, and the web interface writes them here.
config subscription 'default'
	option name 'Top 100'
	option url 'https://raw.githubusercontent.com/0xRadikal/Free-v2ray-Configs/main/top100.txt'
	option enabled '1'

# A server added by hand looks like this. `link` takes one share link, or
# several separated by newlines.
#
# config node
#	option name 'my own server'
#	option link 'vless://...'
#	option enabled '1'
