#
# ovpn-parse - turn share links into something the rest of this can measure
# and run.
#
# Reads links on stdin, one per line, and writes one tab separated record per
# usable server:
#
#     <tag> <label> <protocol> <host> <port> <payload>
#
# For everything Xray speaks natively the payload is the complete outbound
# object, minus its tag. For hysteria2 and tuic - which Xray does not speak -
# the payload is a small description that ovpn-bridge turns into a local
# SOCKS listener, and the tag names a socks outbound pointed at it.
#
# Host and port are their own columns because the first thing that happens to
# a hundred candidates is a handshake to each, and re-parsing JSON in shell a
# hundred times to find out where to knock is the sort of thing that makes a
# router feel slow.
#
# Blank lines, comments and anything it does not understand are skipped in
# silence: a subscription is a moving target, and one malformed entry must
# never cost us the other ninety-nine.
#
# Must be run with LC_ALL=C. base64 decoding here reassembles bytes one at a
# time, and an awk in a UTF-8 locale would re-encode every byte above 127 and
# quietly corrupt every non-English server name.

# ---------------------------------------------------------------- base64

function b64init(   i, chars) {
	chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for (i = 1; i <= 64; i++) B64[substr(chars, i, 1)] = i - 1
	for (i = 1; i < 256; i++) CHR[i] = sprintf("%c", i)
	CHR[0] = ""
	# The other direction, for the one place that has to know what a byte is
	# worth rather than what it looks like: trimming a name without cutting a
	# UTF-8 character in half.
	for (i = 1; i < 256; i++) ORD[CHR[i]] = i
}

# Decoding in awk rather than by piping to base64 is worth the twenty lines:
# a hundred vmess links is a hundred forks otherwise, which on a router costs
# more than everything else this script does put together.
function b64(s,   out, i, c, bits, nbits, n) {
	gsub(/-/, "+", s)
	gsub(/_/, "/", s)
	out = ""; bits = 0; nbits = 0
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (!(c in B64)) continue
		bits = bits * 64 + B64[c]
		nbits += 6
		if (nbits >= 8) {
			nbits -= 8
			n = int(bits / exp2(nbits))
			bits = bits - n * exp2(nbits)
			out = out CHR[n % 256]
		}
	}
	return out
}

function exp2(n,   r, i) {
	r = 1
	for (i = 0; i < n; i++) r = r * 2
	return r
}

# ------------------------------------------------------------- text utils

function jesc(s) {
	gsub(/\\/, "\\\\", s)
	gsub(/"/, "\\\"", s)
	gsub(/\t/, " ", s)
	gsub(/\r/, "", s)
	gsub(/\n/, " ", s)
	return s
}

function hex(h,   d, i, c, v) {
	d = 0
	for (i = 1; i <= length(h); i++) {
		c = tolower(substr(h, i, 1))
		v = index("0123456789abcdef", c) - 1
		if (v < 0) return -1
		d = d * 16 + v
	}
	return d
}

function urldec(s,   out, i, c, h, v) {
	out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "%" && i + 2 <= length(s)) {
			v = hex(substr(s, i + 1, 2))
			if (v >= 0) { out = out CHR[v]; i += 2; continue }
		}
		out = out c
	}
	return out
}

# A server name is decoration. It arrives with channel advertising, control
# characters and occasionally a whole line of emoji in it, so keep it short
# and printable and let the rest go.
function clean_label(s,   c) {
	s = urldec(s)
	gsub(/[[:cntrl:]]/, " ", s)
	gsub(/\|.*$/, "", s)
	gsub(/^[ \t]+|[ \t]+$/, "", s)
	if (length(s) > 48) {
		s = substr(s, 1, 48)
		# This runs in the C locale, where length() counts bytes, so 48 is 48
		# bytes and a Persian, Arabic or Chinese name is two or three bytes a
		# character. Cutting at a fixed count therefore lands in the middle of
		# a character about as often as not, and half a character is not a
		# shorter name - it is a byte sequence that is no longer UTF-8, and it
		# travels all the way to the web interface as a broken one. So walk
		# back off any continuation bytes, and then off the lead byte whose
		# body has just been removed.
		while (length(s) > 0) {
			c = ORD[substr(s, length(s), 1)]
			if (c >= 128 && c < 192) { s = substr(s, 1, length(s) - 1); continue }
			if (c >= 192) s = substr(s, 1, length(s) - 1)
			break
		}
		gsub(/[ \t]+$/, "", s)
	}
	return s
}

# Pull one key out of a query string.
function qs(query, key,   n, parts, i, kv) {
	n = split(query, parts, "&")
	for (i = 1; i <= n; i++) {
		kv = index(parts[i], "=")
		if (kv > 0 && substr(parts[i], 1, kv - 1) == key)
			return urldec(substr(parts[i], kv + 1))
	}
	return ""
}

# Split "host:port", or "[v6]:port", into HOST and PORT. Returns 0 when there
# is no port to be had, which is the one thing that makes a link unusable.
function hostport(s,   p) {
	sub(/\/+$/, "", s)
	p = match(s, /:[0-9]+$/)
	if (p <= 0) return 0
	HOST = substr(s, 1, p - 1)
	PORT = substr(s, p + 1) + 0
	gsub(/^\[|\]$/, "", HOST)
	if (HOST == "" || PORT <= 0 || PORT > 65535) return 0
	return 1
}

# ------------------------------------------------------------ streamSettings

function stream(net, sec, host, path, sni, fp, alpn, pbk, sid, spx, svc, hdr, mode,   s, t, n, a, i) {
	if (net == "") net = "tcp"
	if (net == "h2") net = "http"
	if (net == "splithttp") net = "xhttp"
	s = "\"network\":\"" jesc(net) "\""

	if (sec == "tls" || sec == "reality") {
		s = s ",\"security\":\"" jesc(sec) "\""
		t = "\"serverName\":\"" jesc(sni != "" ? sni : host) "\""
		# Only the fingerprints uTLS actually has, checked against Xray 26.3
		# rather than guessed at. An unknown one is not ignored by the core -
		# it refuses to build the outbound at all, and that costs the whole
		# server over a cosmetic field. Dropping just the fingerprint leaves a
		# server that works; passing it on leaves nothing.
		#
		# ("unsafe" is a real value and means Go's own TLS rather than uTLS.
		# It looks like a mistake and is not one.)
		if (fp ~ /^(chrome|firefox|safari|ios|android|edge|360|qq|random|randomized|randomizednoalpn|unsafe|hellogolang)$/)
			t = t ",\"fingerprint\":\"" jesc(fp) "\""
		if (alpn != "") {
			n = split(alpn, a, ",")
			t = t ",\"alpn\":["
			for (i = 1; i <= n; i++) {
				gsub(/^[ \t]+|[ \t]+$/, "", a[i])
				t = t (i > 1 ? "," : "") "\"" jesc(a[i]) "\""
			}
			t = t "]"
		}
		if (sec == "reality") {
			if (pbk != "") t = t ",\"publicKey\":\"" jesc(pbk) "\""
			if (sid != "") t = t ",\"shortId\":\"" jesc(sid) "\""
			if (spx != "") t = t ",\"spiderX\":\"" jesc(spx) "\""
			s = s ",\"realitySettings\":{" t "}"
		} else {
			# No allowInsecure here, however tempting. Xray removed it in 26.x
			# and now refuses any outbound that still carries it, so writing it
			# would not loosen verification - it would reject every TLS server
			# on the list outright, on the newest core, for all of them at
			# once. A server whose certificate does not verify simply fails
			# its measurement and is passed over, which is the right outcome.
			s = s ",\"tlsSettings\":{" t "}"
		}
	} else {
		s = s ",\"security\":\"none\""
	}

	if (net == "ws") {
		s = s ",\"wsSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"headers\":{\"Host\":\"" jesc(host) "\"}"
		s = s "}"
	} else if (net == "grpc") {
		s = s ",\"grpcSettings\":{\"serviceName\":\"" jesc(svc != "" ? svc : path) "\""
		if (mode == "multi") s = s ",\"multiMode\":true"
		s = s "}"
	} else if (net == "http") {
		s = s ",\"httpSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"host\":[\"" jesc(host) "\"]"
		s = s "}"
	} else if (net == "xhttp") {
		s = s ",\"xhttpSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"host\":\"" jesc(host) "\""
		if (mode != "") s = s ",\"mode\":\"" jesc(mode) "\""
		# `extra` is where xhttp keeps everything that has no query parameter
		# of its own: the padding range, xmux, the separate download
		# connection. It travels in the link as one whole JSON object, so it
		# is passed through as JSON and not quoted into a string - and it is
		# passed through at all because dropping it means connecting on terms
		# the server was not told about. Real links carry it: every xhttp
		# server seen so far sets xPaddingBytes.
		#
		# Only something shaped like an object is taken. A malformed one would
		# be refused by the core along with the whole outbound, which costs
		# that one server - the same as any other unusable entry, and handled
		# the same way.
		if (XEXTRA ~ /^\{.*\}$/ && XEXTRA !~ /[[:cntrl:]]/)
			s = s ",\"extra\":" XEXTRA
		s = s "}"
	} else if (net == "httpupgrade") {
		s = s ",\"httpupgradeSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"host\":\"" jesc(host) "\""
		s = s "}"
	} else if (net == "tcp" && hdr == "http") {
		s = s ",\"tcpSettings\":{\"header\":{\"type\":\"http\",\"request\":{\"path\":[\"" \
		    jesc(path != "" ? path : "/") "\"]"
		if (host != "") s = s ",\"headers\":{\"Host\":[\"" jesc(host) "\"]}"
		s = s "}}}"
	} else if (net == "kcp") {
		s = s ",\"kcpSettings\":{\"header\":{\"type\":\"" jesc(hdr != "" ? hdr : "none") "\"}"
		if (path != "") s = s ",\"seed\":\"" jesc(path) "\""
		s = s "}"
	}
	return s
}

# ------------------------------------------------------------------ output

# The same server turns up in two subscriptions more often than not. Testing
# it twice costs a slot in a batch that another server could have used.
function emit(label, proto, payload,   key, tag) {
	if (HOST == "" || PORT + 0 <= 0) return
	key = proto "|" HOST "|" PORT "|" payload
	if (key in seen) return
	seen[key] = 1
	if (n >= LIMIT) return
	tag = "n" n
	if (label == "") label = HOST ":" PORT
	printf "%s\t%s\t%s\t%s\t%d\t%s\n", tag, jesc(label), proto, HOST, PORT, payload
	n++
}

# ---------------------------------------------------------------- vmess://

# base64 of a flat JSON object: add, port, id, aid, net, type, host, path,
# tls, sni, scy, ps.
function do_vmess(body,   j, k, v, o, label) {
	j = b64(body)
	if (j !~ /"add"/) return
	# One link must never inherit the previous one's xhttp settings.
	XEXTRA = ""
	split("", o)
	# a flat object, so a plain key scan needs no JSON parser
	while (match(j, /"[A-Za-z0-9_-]+"[ \t]*:[ \t]*("[^"]*"|-?[0-9.]+|true|false|null)/)) {
		k = substr(j, RSTART, RLENGTH)
		v = k
		sub(/^"/, "", k); sub(/".*/, "", k)
		sub(/^[^:]*:[ \t]*/, "", v)
		gsub(/^"|"$/, "", v)
		o[k] = v
		j = substr(j, RSTART + RLENGTH)
	}
	HOST = o["add"]; PORT = o["port"] + 0
	gsub(/^\[|\]$/, "", HOST)
	label = clean_label(o["ps"])

	emit(label, "vmess", \
		"{\"protocol\":\"vmess\",\"settings\":{\"vnext\":[{" \
		"\"address\":\"" jesc(HOST) "\",\"port\":" PORT ",\"users\":[{" \
		"\"id\":\"" jesc(o["id"]) "\",\"alterId\":" (o["aid"] + 0) \
		",\"security\":\"" jesc(o["scy"] != "" ? o["scy"] : "auto") "\"}]}]}," \
		"\"streamSettings\":{" \
		stream(o["net"], (o["tls"] != "" ? o["tls"] : "none"), o["host"], o["path"], \
		       o["sni"], o["fp"], o["alpn"], "", "", "", o["path"], o["type"], o["mode"]) \
		"}}")
}

# ---------------------------------------------------------------- vless://

function do_vless(body,   label, uuid, query, p, sec, flow, enc) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	uuid = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	sec = qs(query, "security"); if (sec == "") sec = "none"
	flow = qs(query, "flow")
	enc = qs(query, "encryption"); if (enc == "") enc = "none"
	XEXTRA = qs(query, "extra")

	emit(label, "vless", \
		"{\"protocol\":\"vless\",\"settings\":{\"vnext\":[{" \
		"\"address\":\"" jesc(HOST) "\",\"port\":" PORT ",\"users\":[{" \
		"\"id\":\"" jesc(uuid) "\",\"encryption\":\"" jesc(enc) "\"" \
		(flow != "" ? ",\"flow\":\"" jesc(flow) "\"" : "") "}]}]}," \
		"\"streamSettings\":{" \
		stream(qs(query, "type"), sec, qs(query, "host"), qs(query, "path"), \
		       qs(query, "sni"), qs(query, "fp"), qs(query, "alpn"), \
		       qs(query, "pbk"), qs(query, "sid"), qs(query, "spx"), \
		       qs(query, "serviceName"), qs(query, "headerType"), qs(query, "mode")) \
		"}}")
}

# --------------------------------------------------------------- trojan://

function do_trojan(body,   label, pass, query, p, sec) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	pass = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	# trojan is TLS by definition; a link that does not say so still means it
	sec = qs(query, "security"); if (sec == "" || sec == "none") sec = "tls"
	XEXTRA = qs(query, "extra")

	emit(label, "trojan", \
		"{\"protocol\":\"trojan\",\"settings\":{\"servers\":[{" \
		"\"address\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"password\":\"" jesc(pass) "\"}]}," \
		"\"streamSettings\":{" \
		stream(qs(query, "type"), sec, qs(query, "host"), qs(query, "path"), \
		       qs(query, "sni"), qs(query, "fp"), qs(query, "alpn"), \
		       "", "", "", qs(query, "serviceName"), qs(query, "headerType"), \
		       qs(query, "mode")) \
		"}}")
}

# ------------------------------------------------------------------- ss://
# either base64(method:pass@host:port) or SIP002 base64(method:pass)@host:port

function do_ss(body,   label, p, cred, method, pass, dec, plug) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { plug = substr(body, p + 1); body = substr(body, 1, p - 1) }

	p = index(body, "@")
	if (p > 0) {
		cred = substr(body, 1, p - 1)
		dec = b64(cred)
		# SIP002 keeps the userinfo base64'd; some writers leave it plain
		if (dec ~ /:/) cred = dec
		else cred = urldec(cred)
		if (!hostport(substr(body, p + 1))) return
	} else {
		dec = b64(body)
		p = index(dec, "@")
		if (p <= 0) return
		cred = substr(dec, 1, p - 1)
		if (!hostport(substr(dec, p + 1))) return
	}

	p = index(cred, ":")
	if (p <= 0) return
	method = substr(cred, 1, p - 1)
	pass = substr(cred, p + 1)
	if (method == "") return

	# An obfuscation plugin needs a helper binary this does not ship. Better
	# to drop the entry than to select it and have the tunnel refuse to start.
	if (qs(plug, "plugin") != "") return

	emit(label, "shadowsocks", \
		"{\"protocol\":\"shadowsocks\",\"settings\":{\"servers\":[{" \
		"\"address\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"method\":\"" jesc(method) "\",\"password\":\"" jesc(pass) "\"" \
		",\"uot\":true}]}," \
		"\"streamSettings\":{\"network\":\"tcp\"}}")
}

# --------------------------------------------------- socks:// and http://

function do_proxy(body, proto,   label, p, cred, user, pass, dec, q) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) body = substr(body, 1, p - 1)

	p = index(body, "@")
	if (p > 0) {
		cred = substr(body, 1, p - 1)
		dec = b64(cred)
		if (dec ~ /:/) cred = dec
		else cred = urldec(cred)
		if (!hostport(substr(body, p + 1))) return
		q = index(cred, ":")
		if (q > 0) { user = substr(cred, 1, q - 1); pass = substr(cred, q + 1) }
	} else {
		if (!hostport(body)) return
	}

	emit(label, proto, \
		"{\"protocol\":\"" proto "\",\"settings\":{\"servers\":[{" \
		"\"address\":\"" jesc(HOST) "\",\"port\":" PORT \
		(user != "" ? ",\"users\":[{\"user\":\"" jesc(user) "\",\"pass\":\"" jesc(pass) "\"}]" : "") \
		"}]},\"streamSettings\":{\"network\":\"tcp\"}}")
}

# ------------------------------------------------- hysteria2:// and tuic://
#
# Xray does not speak either. The payload here describes the node; ovpn-bridge
# turns it into a local SOCKS listener run by sing-box or by hysteria itself,
# and the outbound Xray ends up with is a plain socks pointed at that port.
# Nothing else in the program has to know the difference.

function do_hysteria2(body,   label, auth, query, p) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	auth = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	emit(label, "hysteria2", \
		"{\"type\":\"hysteria2\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"password\":\"" jesc(auth) "\"" \
		",\"sni\":\"" jesc(qs(query, "sni")) "\"" \
		",\"obfs\":\"" jesc(qs(query, "obfs")) "\"" \
		",\"obfs_password\":\"" jesc(qs(query, "obfs-password")) "\"" \
		",\"insecure\":" (qs(query, "insecure") == "1" ? "true" : "false") "}")
}

function do_tuic(body,   label, cred, uuid, pass, query, p, q) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	cred = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return
	q = index(cred, ":")
	if (q <= 0) return
	uuid = substr(cred, 1, q - 1)
	pass = substr(cred, q + 1)

	emit(label, "tuic", \
		"{\"type\":\"tuic\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"uuid\":\"" jesc(uuid) "\",\"password\":\"" jesc(pass) "\"" \
		",\"sni\":\"" jesc(qs(query, "sni")) "\"" \
		",\"congestion_control\":\"" jesc(qs(query, "congestion_control")) "\"" \
		",\"alpn\":\"" jesc(qs(query, "alpn")) "\"" \
		",\"insecure\":" (qs(query, "allow_insecure") == "1" ? "true" : "false") "}")
}

# -------------------------------------------------------------------------

BEGIN {
	n = 0
	FS = "\n"
	b64init()
	if (LIMIT + 0 <= 0) LIMIT = 400
}

# Most subscriptions hand back one base64 blob rather than a list of links.
# Decoding it needs exactly the decoder above, so -v DECODE=1 turns this into
# that one job rather than duplicating it in shell against a `base64` binary
# that may not be installed.
DECODE { blob = blob $0; next }

END { if (DECODE) printf "%s", b64(blob) }

!DECODE {
	line = $0
	gsub(/\r/, "", line)
	sub(/^[ \t]+/, "", line)
	sub(/[ \t]+$/, "", line)
	if (line == "" || substr(line, 1, 1) == "#") next
	if (n >= LIMIT) next

	HOST = ""; PORT = 0

	if      (index(line, "vmess://")     == 1) do_vmess(substr(line, 9))
	else if (index(line, "vless://")     == 1) do_vless(substr(line, 9))
	else if (index(line, "trojan://")    == 1) do_trojan(substr(line, 10))
	else if (index(line, "ss://")        == 1) do_ss(substr(line, 6))
	else if (index(line, "socks5://")    == 1) do_proxy(substr(line, 10), "socks")
	else if (index(line, "socks://")     == 1) do_proxy(substr(line, 9), "socks")
	else if (index(line, "hysteria2://") == 1) do_hysteria2(substr(line, 13))
	else if (index(line, "hy2://")       == 1) do_hysteria2(substr(line, 7))
	else if (index(line, "tuic://")      == 1) do_tuic(substr(line, 8))
}
