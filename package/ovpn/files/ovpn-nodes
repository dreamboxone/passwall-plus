#
# ovpn-nodes - where the servers come from.
#
#   ovpn-nodes fetch    re-read every enabled subscription
#   ovpn-nodes build    turn what we have into candidates
#   ovpn-nodes update   both
#   ovpn-nodes status   one line per subscription, for the web interface
#
# Subscriptions and hand-added nodes both live in /etc/config/ovpn, as
# `config subscription` and `config node` sections. Adding either is a UCI
# edit and nothing more, which is what lets the web interface offer it
# without this script needing to know the web interface exists.

set -e

. "${OVPN_LIB:-/usr/libexec}/ovpn-common.sh"
. /lib/functions.sh

PARSE="${OVPN_LIB:-/usr/libexec}/ovpn-parse"
LINKS="$OVPN_RUN/links.txt"
SUBS_STATUS="$OVPN_RUN/subs.status"
# Servers that were already records before the build started: a subscription
# that hands back a configuration rather than a list is parsed where it is
# read, because a configuration only means anything whole and the file the
# links go into holds several sources at once.
PRE_TSV="$OVPN_RUN/pre.tsv"

# ---------------------------------------------------------------- fetching

fetch_one() {
	_sec="$1"
	local url name enabled
	config_get url "$_sec" url ""
	config_get name "$_sec" name "$_sec"
	config_get_bool enabled "$_sec" enabled 1

	[ "$enabled" = "1" ] || return 0
	[ -n "$url" ] || return 0

	# The address as written, then the mirrors of it, because the default list
	# is on a host that is blocked from precisely the connections this program
	# exists to fix. The mirrors are given a shorter leash than the address the
	# user actually asked for: this runs every quarter of an hour, and three
	# long timeouts in a row is a quarter of an hour spent waiting.
	_tmp="$OVPN_RUN/sub.$_sec"
	_got=0
	_first=1
	for _try in "$url" $(mirrors_for "$url"); do
		if [ "$_first" = "1" ]; then
			_ct=8; _mt=30; _rt=1
		else
			_ct=6; _mt=20; _rt=0
		fi
		_first=0
		# A blocked address does not refuse, it hangs, so the whole point of
		# these numbers is the worst case: three sources at the old timeouts
		# was four minutes of a fifteen-minute schedule spent waiting. The
		# list is a few kilobytes; twenty seconds is not a tight budget for it.
		if curl -fsSL --connect-timeout "$_ct" --max-time "$_mt" --retry "$_rt" -o "$_tmp" "$_try" 2>/dev/null; then
			_got=1
			[ "$_try" = "$url" ] || log "subscription '$name': unreachable, read from $_try instead"
			break
		fi
		rm -f "$_tmp"
	done
	if [ "$_got" != "1" ]; then
		printf '%s\t%s\t0\t0\t%s\n' "$name" "$url" "download failed" >> "$SUBS_STATUS"
		warn "subscription '$name': download failed"
		rm -f "$_tmp"
		return 0
	fi

	# A subscription that answers with an error page, a login form or half a
	# file must never replace what we already have.
	if [ "$(wc -c < "$_tmp")" -lt 64 ]; then
		printf '%s\t%s\t0\t0\t%s\n' "$name" "$url" "answer too short" >> "$SUBS_STATUS"
		warn "subscription '$name': answer too short"
		rm -f "$_tmp"
		return 0
	fi

	# A configuration rather than a list: Xray, sing-box, Clash, or an array
	# of nodes. It is read here, on its own, and not added to the pile of
	# links - a configuration has to be parsed whole, and the file the links
	# are collected in has more than one source in it.
	_head="$(sed -n '1,20p' "$_tmp" 2>/dev/null | tr -d ' \t\r\n' | cut -c1)"
	if [ "$_head" = "{" ] || [ "$_head" = "[" ]; then
		_before="$(wc -l < "$PRE_TSV" 2>/dev/null || echo 0)"
		LC_ALL=C awk -v LIMIT="$(cfg max_nodes 300)" -f "$PARSE" < "$_tmp" >> "$PRE_TSV" 2>/dev/null || true
		_count="$(wc -l < "$PRE_TSV" 2>/dev/null || echo 0)"
		_count=$((_count - _before))
		[ "$_count" -ge 0 ] 2>/dev/null || _count=0
		if [ "$_count" -gt 0 ]; then
			printf '%s\t%s\t%s\t%s\t\n' "$name" "$url" "$_count" "$(date +%s)" >> "$SUBS_STATUS"
		else
			printf '%s\t%s\t0\t0\t%s\n' "$name" "$url" "no servers in that configuration" >> "$SUBS_STATUS"
			warn "subscription '$name': read as a configuration, no servers in it"
		fi
		rm -f "$_tmp"
		return 0
	fi

	# Most providers hand back one base64 blob rather than a list of links.
	if ! grep -q '://' "$_tmp" 2>/dev/null; then
		if LC_ALL=C awk -v DECODE=1 -f "$PARSE" < "$_tmp" > "$_tmp.dec" 2>/dev/null &&
		   grep -q '://' "$_tmp.dec" 2>/dev/null; then
			mv -f "$_tmp.dec" "$_tmp"
		else
			rm -f "$_tmp.dec"
			printf '%s\t%s\t0\t0\t%s\n' "$name" "$url" "nothing that looks like a server link" >> "$SUBS_STATUS"
			warn "subscription '$name': nothing that looks like a server link"
			rm -f "$_tmp"
			return 0
		fi
	fi

	_count="$(grep -c '://' "$_tmp" 2>/dev/null || echo 0)"
	cat "$_tmp" >> "$OVPN_RUN/links.new"
	echo >> "$OVPN_RUN/links.new"
	printf '%s\t%s\t%s\t%s\t\n' "$name" "$url" "$_count" "$(date +%s)" >> "$SUBS_STATUS"
	rm -f "$_tmp"
	return 0
}

cmd_fetch() {
	: > "$OVPN_RUN/links.new"
	: > "$SUBS_STATUS"
	: > "$PRE_TSV"

	# Nothing to fetch when the subscriptions are switched off. Worth saying
	# out loud because it is not only tidiness: on a censored connection the
	# list address hangs rather than refusing, so this is the difference
	# between a refresh that takes a moment and one that spends a minute
	# failing to read something nobody asked for.
	if [ "$(cfg sources both)" = "own" ]; then
		rm -f "$OVPN_RUN/links.new"
		return 0
	fi

	config_load ovpn
	config_foreach fetch_one subscription

	# A source that handed back a configuration has already been turned into
	# records, so "nothing answered" has to mean neither happened.
	if ! grep -q '://' "$OVPN_RUN/links.new" 2>/dev/null && [ ! -s "$PRE_TSV" ]; then
		rm -f "$OVPN_RUN/links.new"
		# Every source failed. The copy on disk is the whole reason there is
		# one: a router that reboots into a censored morning still has last
		# night's list and can still connect.
		if [ -s "$OVPN_NODE_CACHE" ]; then
			log "no subscription answered - keeping the list already on disk"
			cp -f "$OVPN_NODE_CACHE" "$LINKS"
			return 0
		fi
		# Deliberately no message on the front page here. Failing to read a
		# subscription is only half a fact: a router with a server added by
		# hand connects perfectly well without one, and telling that user
		# their list is unreadable - on the page they came to press Connect
		# on, before they have pressed anything - is alarming and wrong.
		# Which source failed and why is on the Servers page, beside the
		# source. The front page is told once, by cmd_build, and only when
		# there is genuinely nothing left to connect through.
		warn "no subscription answered and nothing saved"
		return 1
	fi

	mv -f "$OVPN_RUN/links.new" "$LINKS"

	# Written to flash only when it actually differs. Refreshed every quarter
	# of an hour, an unconditional copy would be thirty-five thousand writes a
	# year of a file that is usually identical to the one already there.
	if write_if_changed "$LINKS" "$OVPN_NODE_CACHE"; then
		log "server list changed - saved"
	fi
	return 0
}

# ---------------------------------------------------------------- building

add_node() {
	_sec="$1"
	local link name enabled
	config_get link "$_sec" link ""
	config_get name "$_sec" name ""
	config_get_bool enabled "$_sec" enabled 1
	[ "$enabled" = "1" ] || return 0
	[ -n "$link" ] || return 0

	# One section may hold several links pasted at once, separated by spaces
	# or by newlines. Splitting on every space - which is what this did - cuts
	# a name in half: a link ending "#سرور خانه" became "#سرور" plus a stray
	# word that parses as nothing at all. Names with spaces in them are
	# ordinary, so split only where a new link actually begins.
	#
	# A name typed into the web interface is the name the reader gave this
	# server, and it should be the name they see in the list afterwards rather
	# than whatever the channel that published the link called it. The parser
	# reads names from after the #, so that is where it is put - and only when
	# the link has none of its own, because a name that came with the link is
	# not ours to overwrite.
	printf '%s\n' "$link" | NAME="$name" LC_ALL=C awk '
		{
			gsub(/[ \t]+[a-zA-Z][a-zA-Z0-9+.-]*:\/\//, "\n&")
			n = split($0, lines, "\n")
			for (i = 1; i <= n; i++) {
				l = lines[i]
				gsub(/^[ \t]+|[ \t]+$/, "", l)
				if (l == "") continue
				if (ENVIRON["NAME"] != "" && index(l, "#") == 0)
					l = l "#" ENVIRON["NAME"]
				print l
			}
		}' >> "$OVPN_RUN/manual.txt"
	return 0
}

cmd_build() {
	# both / own / subs. Which servers are allowed into the running, before
	# anything is measured. "both" is the default and the useful answer: a
	# server added by hand does not replace the list, it joins it.
	_sources="$(cfg sources both)"

	_src="$LINKS"
	[ -s "$_src" ] || _src="$OVPN_NODE_CACHE"

	: > "$OVPN_RUN/build.txt"
	if [ "$_sources" != "own" ] && [ -s "$_src" ]; then
		cat "$_src" >> "$OVPN_RUN/build.txt"
	fi

	# Hand-added nodes go in ahead of the subscriptions. They were typed in on
	# purpose, so when a limit has to bite it should bite the free list first.
	# It is an order, not a preference: what is actually used is whichever
	# server answers fastest, out of all of them.
	: > "$OVPN_RUN/manual.txt"
	if [ "$_sources" != "subs" ]; then
		config_load ovpn
		config_foreach add_node node
	fi
	if [ -s "$OVPN_RUN/manual.txt" ]; then
		cat "$OVPN_RUN/build.txt" >> "$OVPN_RUN/manual.txt"
		mv -f "$OVPN_RUN/manual.txt" "$OVPN_RUN/build.txt"
	fi
	rm -f "$OVPN_RUN/manual.txt"

	# Whether there was anything at all to read decides which of two very
	# different things went wrong, so it is worth knowing before the file goes.
	_had=0
	if grep -q '://' "$OVPN_RUN/build.txt" 2>/dev/null; then
		_had=1
	fi
	if [ -s "$PRE_TSV" ]; then
		_had=1
	fi

	_limit="$(cfg max_nodes 300)"
	LC_ALL=C awk -v LIMIT="$_limit" -f "$PARSE" < "$OVPN_RUN/build.txt" > "$OVPN_RUN/links.tsv" 2>/dev/null || true
	rm -f "$OVPN_RUN/build.txt"

	# Links first, then whatever came out of a configuration. Two parser runs
	# cannot know about each other, so the tags they hand out collide and the
	# same server can be in both: this renumbers and keeps the first of each.
	: > "$OVPN_RUN/merge.tsv"
	if [ -s "$OVPN_RUN/links.tsv" ]; then
		cat "$OVPN_RUN/links.tsv" >> "$OVPN_RUN/merge.tsv"
	fi
	if [ "$_sources" != "own" ] && [ -s "$PRE_TSV" ]; then
		cat "$PRE_TSV" >> "$OVPN_RUN/merge.tsv"
	fi
	rm -f "$OVPN_RUN/links.tsv"

	LC_ALL=C awk -F'\t' -v LIMIT="$_limit" '
		NF >= 6 {
			key = $3 "|" $4 "|" $5 "|" $6
			if (key in seen) next
			seen[key] = 1
			if (m >= LIMIT) next
			printf "n%d\t%s\t%s\t%s\t%s\t%s\n", m, $2, $3, $4, $5, $6
			m++
		}' "$OVPN_RUN/merge.tsv" > "$OVPN_CANDIDATES.new" 2>/dev/null || true
	rm -f "$OVPN_RUN/merge.tsv"

	if [ ! -s "$OVPN_CANDIDATES.new" ]; then
		rm -f "$OVPN_CANDIDATES.new"
		if [ "$_had" = "1" ]; then
			say_message "Nothing in the list could be read as a server"
		else
			# The one case that genuinely stops the user from connecting, and
			# the only one this page says anything about. It names the way out,
			# because on a censored connection the list address is unreachable
			# until the tunnel is up and the tunnel needs a server first - and
			# one link pasted in by hand breaks that circle.
			say_message "There is no server list yet: no subscription could be read and none has been saved before. Add one server by hand on the Servers page - a single share link is enough - or check the subscription address there."
		fi
		warn "no usable servers in the list"
		return 1
	fi

	mv -f "$OVPN_CANDIDATES.new" "$OVPN_CANDIDATES"
	log "$(wc -l < "$OVPN_CANDIDATES") servers to choose from"
	return 0
}

cmd_status() {
	cat "$SUBS_STATUS" 2>/dev/null || true
	return 0
}

case "${1:-update}" in
	fetch)  cmd_fetch ;;
	build)  cmd_build ;;
	update) cmd_fetch || true; cmd_build ;;
	status) cmd_status ;;
	*) echo "usage: $0 fetch|build|update|status" >&2; exit 1 ;;
esac
